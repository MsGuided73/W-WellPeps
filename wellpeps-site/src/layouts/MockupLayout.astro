---
/**
 * Minimal shell for the dev-only mockup pages (src/pages/dev-mockups). It is
 * not used by any real page. The mockup routes exist only under `npm run dev`;
 * production builds skip them (see getStaticPaths in dev-mockups/[name].astro).
 */
import '../styles/fonts.css';
import '../styles/global.css';
import PrivacyRoot from '../components/privacy/PrivacyRoot.astro';
import PrivacyBanner from '../components/privacy/PrivacyBanner.astro';
import TweakPanel from '../components/dev/TweakPanel.astro';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} (mockup)</title>
  </head>
  <body>
    <div class="mock-bar" role="note">
      <strong>MOCKUP</strong> &mdash; {title}. Development preview only; this route is not built for the live site.
    </div>
    <PrivacyBanner />
    <main><slot /></main>
    <PrivacyRoot />
    <TweakPanel />
    <style is:global>
      .mock-bar { background: #fff3df; color: #6b3d06; text-align: center; padding: 0.6rem 1rem; font: 600 0.95rem var(--font-sans); border-bottom: 1px solid #f0d49c; }
      .mock-filler { min-height: 38vh; display: grid; place-items: center; color: var(--text-muted); background: var(--bg-gray); text-align: center; padding: 2rem; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    </style>
  </body>
</html>
