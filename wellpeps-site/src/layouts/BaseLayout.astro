---
import '../styles/fonts.css';
import '../styles/global.css';
// The two files nearly every page needs, preloaded so text does not shift when
// the fonts arrive. Same files fonts.css points to, so they are fetched once.
import interLatin from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import loraLatin from '../../node_modules/@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
import CheckoutLock from '../components/CheckoutLock.astro';
import PrivacyRoot from '../components/privacy/PrivacyRoot.astro';
import PrivacyBanner from '../components/privacy/PrivacyBanner.astro';
import TweakPanel from '../components/dev/TweakPanel.astro';

import { SHARE_IMAGE, SITE_NAME, absoluteUrl, canonicalUrl } from '../lib/seo/site';
import { organization, serializeGraph, webPage, website, type JsonLd, type PageMeta } from '../lib/seo/schema';

interface Props {
  title?: string;
  description?: string;
  /** Keeps a page out of search results (draft pages). It then gets no canonical and no structured data. */
  noindex?: boolean;
  /** Extra structured data for this page (breadcrumbs, FAQs, the program's offers, an article). */
  jsonLd?: readonly (JsonLd | undefined)[];
  /** schema.org type of the page itself. */
  pageType?: PageMeta['type'];
  /** og:type: an article page is "article". */
  ogType?: 'website' | 'article';
}
const {
  noindex = false,
  title = 'WellPeps — Personalized Wellness. Simplified.',
  description = 'Personalized treatment plans, licensed healthcare providers, and ongoing support—all from the comfort of home. See if you qualify.',
  jsonLd = [],
  pageType,
  ogType = 'website',
} = Astro.props;

// Search and sharing (src/lib/seo). Every indexable page names its one canonical address, carries a share
// card, and describes itself and WellPeps in structured data built from the same data files it renders.
const canonical = canonicalUrl(Astro.url.pathname);
const shareImage = absoluteUrl(SHARE_IMAGE.path);
const graph = noindex
  ? ''
  : serializeGraph([organization(), website(), webPage({ path: Astro.url.pathname, title, description, type: pageType }), ...jsonLd]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
    <link rel="icon" type="image/png" href="/images/w-mark-v2.png" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {/* Bing Webmaster Tools ownership verification (added 2026-10-26). Bing
        checks the home page; the shared layout ships it on every page, which
        Bing accepts and which keeps it from being lost in a home-page rework. */}
    <meta name="msvalidate.01" content="A983B447857BBC7CB354FF71510E01AE" />
    <meta name="theme-color" content="#082b59" />
    <link rel="apple-touch-icon" href="/images/w-mark-v2.png" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
    <meta property="og:image:alt" content={SHARE_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {graph && <script type="application/ld+json" set:html={graph} />}

    <!-- Fonts: Lora (editorial serif headings, per MASTER Guide) + Inter (UI/body),
         served from this site (styles/fonts.css), so a visit sends nothing to Google. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={loraLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <PrivacyBanner />
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Assistant />
    <CheckoutLock />
    <PrivacyRoot />
    <TweakPanel />

    <style>
      .skip-link {
        position: absolute; left: 1rem; top: 1rem; z-index: 200;
        background: var(--blue); color: #fff; padding: 0.6rem 1rem;
        border-radius: 8px;
        transform: translateY(calc(-100% - 1.5rem));
        transition: transform var(--dur) var(--ease);
      }
      .skip-link:focus { transform: translateY(0); color: #fff; }
    </style>

    <!-- Progressive enhancement: scroll reveal + FAQ + mobile nav -->
    <script>
      // Reveal on scroll. Trigger as soon as any part of a block is on screen (threshold 0), not a
      // share of it: a tall block, such as a product grid stacked on a phone, can be taller than
      // several screens and would never reach a percentage threshold, staying invisible.
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }

      // Sticky nav shadow on scroll
      const nav = document.querySelector('[data-nav]');
      const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobile nav toggle
      const toggle = document.querySelector('[data-nav-toggle]');
      const menu = document.querySelector('[data-nav-menu]');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          nav?.classList.remove('nav-open');
          toggle?.setAttribute('aria-expanded', 'false');
        })
      );

      // FAQ accordion
      document.querySelectorAll('[data-faq]').forEach((item) => {
        const btn = item.querySelector('button');
        btn?.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
        });
      });
    </script>
  </body>
</html>
