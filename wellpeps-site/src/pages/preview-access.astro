---
/**
 * Private-preview gate page.
 *
 * nginx serves this file (dist/preview-access/index.html) with status 401 at
 * whatever URL a locked visitor asked for — see nginx.conf.template. It is
 * standalone on purpose: no BaseLayout nav/footer, nothing that links into
 * the gated site. `npm run dev` never shows it in place of a page; it is
 * only reachable directly at /preview-access/ in dev, and is 404 in
 * production except as the gate response.
 *
 * All asset URLs must be root-absolute: the page renders at arbitrary paths.
 */
import '../styles/tokens.css';

const PHONE = '(833) 935-7377';
const PHONE_HREF = 'tel:+18339357377';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="/images/w-mark-v2.png" />
    <title>WellPeps — Coming Soon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="gate">
      <div class="gate__card">
        <img
          class="gate__logo"
          src="/images/logo-full-v2.png"
          alt="WellPeps"
          width="600"
          height="125"
        />
        <h1 class="gate__title">Coming Soon</h1>
        <p class="gate__lead">
          WellPeps is launching soon. If you have an access password, enter it below.
        </p>

        <form class="gate__form" data-gate-form novalidate>
          <label class="gate__label" for="gate-password">Access password</label>
          <input
            class="gate__input"
            id="gate-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            aria-describedby="gate-status"
          />
          <p class="gate__status" id="gate-status" role="alert" aria-live="assertive" data-gate-status></p>
          <button class="gate__button" type="submit" data-gate-submit>Continue</button>
        </form>

        <p class="gate__contact">
          Questions? Call us at <a href={PHONE_HREF}>{PHONE}</a>.
        </p>
      </div>
    </main>

    <script>
      import { GATE_HEADER, GATE_UNLOCK_PATH, gateHash } from '../lib/gate';

      const MESSAGES: Record<string, string> = {
        empty: 'Please enter the access password.',
        wrong: "That password isn't right.",
        limited: 'Too many attempts. Please wait a minute and try again.',
        failed: 'Something went wrong. Please try again.',
      };

      const form = document.querySelector<HTMLFormElement>('[data-gate-form]');
      const input = document.querySelector<HTMLInputElement>('#gate-password');
      const status = document.querySelector<HTMLElement>('[data-gate-status]');
      const submit = document.querySelector<HTMLButtonElement>('[data-gate-submit]');

      const show = (key: keyof typeof MESSAGES | '') => {
        if (!status || !input) return;
        status.textContent = key ? MESSAGES[key] : '';
        input.setAttribute('aria-invalid', key ? 'true' : 'false');
      };

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!input || !submit) return;
        const password = input.value;
        if (!password) {
          show('empty');
          input.focus();
          return;
        }

        submit.disabled = true;
        show('');
        try {
          const hash = await gateHash(password);
          const res = await fetch(GATE_UNLOCK_PATH, {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { [GATE_HEADER]: hash },
          });
          if (res.status === 204) {
            // The gate is served at the visitor's own URL, so reloading shows
            // the page they originally asked for.
            location.reload();
            return;
          }
          show(res.status === 403 ? 'wrong' : res.status === 429 ? 'limited' : 'failed');
        } catch {
          show('failed');
        }
        submit.disabled = false;
        input.select();
        input.focus();
      });
    </script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: var(--font-sans);
        font-size: var(--text-body-size);
        line-height: 1.6;
        color: var(--text-body);
        background:
          radial-gradient(1200px 600px at 50% -10%, var(--bg-light-sky), transparent 70%),
          var(--bg-pale-blue);
      }
    </style>

    <style>
      .gate {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
      }
      .gate__card {
        width: 100%;
        max-width: 30rem;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: clamp(1.75rem, 1.2rem + 2.5vw, 2.75rem);
        text-align: center;
      }
      .gate__logo {
        display: block;
        height: 48px;
        width: auto;
        max-width: 100%;
        margin: 0 auto 1.75rem;
      }
      .gate__title {
        margin: 0 0 0.75rem;
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.25rem);
        line-height: 1.2;
        color: var(--text-heading);
      }
      .gate__lead {
        margin: 0 0 1.75rem;
        font-size: var(--text-body-size);
      }
      .gate__form {
        display: grid;
        gap: 0.5rem;
        text-align: left;
      }
      .gate__label {
        font-weight: 600;
        color: var(--navy);
      }
      .gate__input {
        width: 100%;
        min-height: 3rem;
        padding: 0.75rem 1rem;
        font: inherit;
        color: var(--navy);
        background: var(--white);
        border: 1.5px solid var(--border-strong);
        border-radius: var(--radius-sm);
        transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
      }
      .gate__input:focus-visible {
        outline: none;
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(21, 118, 196, 0.25);
      }
      .gate__input[aria-invalid='true'] { border-color: var(--error); }
      .gate__status {
        margin: 0;
        min-height: 1.6em;
        font-size: var(--text-note);
        font-weight: 500;
        color: var(--error);
      }
      .gate__button {
        min-height: 3rem;
        margin-top: 0.25rem;
        padding: 0.75rem 1.5rem;
        font: inherit;
        font-weight: 600;
        color: var(--white);
        background: var(--navy);
        border: 0;
        border-radius: var(--radius-pill);
        cursor: pointer;
        transition: background-color var(--dur-fast) var(--ease);
      }
      .gate__button:hover { background: var(--blue-hover); }
      .gate__button:focus-visible {
        outline: 3px solid var(--blue);
        outline-offset: 3px;
      }
      .gate__button:disabled { opacity: 0.7; cursor: progress; }
      .gate__contact {
        margin: 1.75rem 0 0;
        font-size: var(--text-note);
        color: var(--text-body);
      }
      .gate__contact a {
        white-space: nowrap;
        color: var(--blue);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .gate__contact a:focus-visible {
        outline: 3px solid var(--blue);
        outline-offset: 2px;
        border-radius: 2px;
      }
    </style>
  </body>
</html>
