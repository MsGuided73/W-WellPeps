---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeightHero from '../components/sections/weight/WeightHero.astro';
import WeightHowItWorks from '../components/sections/weight/WeightHowItWorks.astro';
import WeightWhyChoose from '../components/sections/weight/WeightWhyChoose.astro';
import WeightProducts from '../components/sections/weight/WeightProducts.astro';
import WhatsIncluded from '../components/sections/WhatsIncluded.astro';
import WeightFaq from '../components/sections/weight/WeightFaq.astro';
import WeightCta from '../components/sections/weight/WeightCta.astro';
import EbookOffer from '../components/EbookOffer.astro';
import GuideBand from '../components/guides/GuideBand.astro';
import { GUIDE_LANDING_FLOW } from '../config';
import { ebooksFor } from '../data/ebooks';
import { programAt, startingPrice } from '../lib/seo/catalog';
import { breadcrumbs, faqPage, programService } from '../lib/seo/schema';
const program = programAt('/weight-loss/');
const from = startingPrice(program);
const description = `Online GLP-1 weight loss with semaglutide or tirzepatide, prescribed by a licensed clinician if appropriate. From $${from}/month, medication included.`;
const jsonLd = [
  breadcrumbs([{ name: 'Weight Management', path: '/weight-loss/' }]),
  programService(program),
  faqPage(program.faqs, program.path),
];
---
<BaseLayout
  title="GLP-1 Weight Loss Online: Semaglutide & Tirzepatide | WellPeps"
  description={description}
  jsonLd={jsonLd}
>
  <WeightHero />
  <WeightHowItWorks />
  {GUIDE_LANDING_FLOW && <GuideBand program="weight-loss" />}
  <WeightWhyChoose />
  <WeightProducts />
  <WhatsIncluded />
  {!GUIDE_LANDING_FLOW && <EbookOffer books={ebooksFor('weight-loss')} variant="band" />}
  <WeightFaq />
  <WeightCta />
</BaseLayout>
