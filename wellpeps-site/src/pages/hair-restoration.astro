---
import BaseLayout from '../layouts/BaseLayout.astro';
import HairHero from '../components/sections/hair/HairHero.astro';
import HairComingSoon from '../components/sections/hair/HairComingSoon.astro';
import HairHowItWorks from '../components/sections/hair/HairHowItWorks.astro';
import HairProducts from '../components/sections/hair/HairProducts.astro';
import HairFaq from '../components/sections/hair/HairFaq.astro';
import HairCta from '../components/sections/hair/HairCta.astro';
import { GUIDE_LANDING_FLOW, HAIR_COMING_SOON } from '../config';
import EbookOffer from '../components/EbookOffer.astro';
import GuideBand from '../components/guides/GuideBand.astro';
import { ebooksFor } from '../data/ebooks';
---
<BaseLayout
  title="Hair Restoration — WellPeps"
  description="Advanced, FDA-approved hair restoration treatments and expert care to help you achieve visibly thicker, healthier hair. Start your free online health assessment."
>
  <HairHero />
  {HAIR_COMING_SOON && <HairComingSoon />}
  <HairHowItWorks />
  {GUIDE_LANDING_FLOW && <GuideBand program="hair-restoration" />}
  <HairProducts />
  {!GUIDE_LANDING_FLOW && <EbookOffer books={ebooksFor('hair-restoration')} variant="band" />}
  <HairFaq />
  <HairCta />
</BaseLayout>
