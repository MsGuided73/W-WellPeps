---
import BaseLayout from '../layouts/BaseLayout.astro';
import Fold from '../components/Fold.astro';
import ShopChrome from '../components/ShopChrome.astro';
import ShopShelf from '../components/ShopShelf.astro';
import ShopSticky from '../components/ShopSticky.astro';
import HairHero from '../components/sections/hair/HairHero.astro';
import HairComingSoon from '../components/sections/hair/HairComingSoon.astro';
import HairHowItWorks from '../components/sections/hair/HairHowItWorks.astro';
import HairProducts from '../components/sections/hair/HairProducts.astro';
import HairFaq from '../components/sections/hair/HairFaq.astro';
import HairCta from '../components/sections/hair/HairCta.astro';
import { HAIR_COMING_SOON } from '../config';
import GuideBand from '../components/guides/GuideBand.astro';
import { programAt, startingPrice } from '../lib/seo/catalog';
import { breadcrumbs, faqPage, programService } from '../lib/seo/schema';
const program = programAt('/hair-restoration/');
const from = startingPrice(program);
const description = `Online hair loss treatment with finasteride or minoxidil, oral or topical, reviewed by a licensed provider. From $${from}/month, medication included.`;
const jsonLd = [
  breadcrumbs([{ name: 'Hair Restoration', path: '/hair-restoration/' }]),
  programService(program),
  faqPage(program.faqs, program.path),
];
---
<BaseLayout
  mainClass="page-flow"
  title="Hair Loss Treatment Online: Finasteride & Minoxidil | WellPeps"
  description={description}
  jsonLd={jsonLd}
>
  <HairHero />
  <ShopShelf only="hair-restoration" />
  {HAIR_COMING_SOON && <HairComingSoon />}
  <Fold label="How it works"><HairHowItWorks /></Fold>
  <Fold label="Free guide"><GuideBand program="hair-restoration" /></Fold>
  <Fold label="Full details"><HairProducts /></Fold>
  <Fold label="Common Questions"><HairFaq /></Fold>
  <Fold label="Get started"><HairCta /></Fold>
  <ShopSticky program="hair-restoration" />
  <ShopChrome />
</BaseLayout>
