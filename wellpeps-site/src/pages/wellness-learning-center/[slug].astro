---
/**
 * Wellness Learning Center — article page.
 *
 * Layout follows the approved mockup: a two-column reading view with the
 * article on the left and a sticky rail carrying the "Personalized Care" CTA
 * and the medical disclaimer. Those two blocks, plus Key Takeaways, are stored
 * as their own columns rather than inside body_html, so the design can place
 * them independently of the prose.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { article as schemaArticle, breadcrumbs, reviewerPerson } from '../../lib/seo/schema';
import { formatReviewDate, npiRegistryUrl, reviewForArticle, reviewerName, reviewerPath, reviewerShortName } from '../../data/medical-review';
import EverythingIncludedStrip from '../../components/EverythingIncludedStrip.astro';
import GuideArticleCta from '../../components/guides/GuideArticleCta.astro';
import { guideForArticle } from '../../lib/guide-flow';
import HairTreatmentOptions from '../../components/sections/HairTreatmentOptions.astro';
import PeptideTherapies from '../../components/sections/PeptideTherapies.astro';
import SexualTreatmentOptions from '../../components/sections/SexualTreatmentOptions.astro';
import WeightTreatmentOptions from '../../components/sections/WeightTreatmentOptions.astro';
import AssessmentCta from '../../components/AssessmentCta.astro';
import MdReviewedBadge from '../../components/MdReviewedBadge.astro';
import { sealMarkup } from '../../lib/md-seal';
import type { ProgramSlug } from '../../lib/cta';
import { getArticles, getRelatedArticles, type ArticleWithCategory } from '../../lib/blog';
import { withToc } from '../../lib/toc';
import ArticleTocRail from '../../components/ArticleTocRail.astro';
import ArticleDiagram from '../../components/ArticleDiagram.astro';
import { coverForArticle, diagramForArticle } from '../../data/article-heroes';
import { middleSectionStart, sectionEnd, splitBody } from '../../lib/article-body';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: ArticleWithCategory;
}

const { article } = Astro.props;
// Physician review (src/data/medical-review.ts): shown under the title and at the end, and in the structured data.
const review = reviewForArticle(article.slug);
// Search: breadcrumbs and a BlogPosting for this article (src/lib/seo/schema.ts).
const articlePath = `/wellness-learning-center/${article.slug}/`;
const articleDescription = article.meta_description ?? article.lede_html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().slice(0, 160);
// Published and Last updated, both shown in full (owner, 2026-10-19). An update stamp older than the publish
// date (or missing) falls back to the publish date. Adding a medical review changes the page, so a review
// newer than the row's last edit becomes the "Last updated" date (and dateModified) too.
const publishedIso = article.published_at;
const rowUpdatedIso = publishedIso && article.updated_at && article.updated_at > publishedIso ? article.updated_at : publishedIso;
const updatedIso = review && (!rowUpdatedIso || review.reviewedOn > rowUpdatedIso.slice(0, 10)) ? review.reviewedOn : rowUpdatedIso;
const longDate = (iso: string) =>
  /^\d{4}-\d{2}-\d{2}$/.test(iso)
    ? formatReviewDate(iso)
    : new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/New_York' });

/* Graphics (src/data/article-heroes.ts): a cover photo under the title, which is also the share image, and a
   "how it works" diagram at the end of the section it explains (approved ones; drafts too in `astro dev`). */
const cover = coverForArticle(article.slug);
const diagram = diagramForArticle(article.slug, { includeDrafts: import.meta.env.DEV });

const jsonLd = [
  breadcrumbs([{ name: 'Wellness Learning Center', path: '/wellness-learning-center/' }, { name: article.title, path: articlePath }]),
  schemaArticle({ path: articlePath, headline: article.title, description: articleDescription, section: article.category.name, published: publishedIso, updated: updatedIso, readingMinutes: article.reading_minutes, image: cover?.src }),
  review && reviewerPerson(review.reviewer),
];
const { html: bodyHtml, toc } = withToc(article.body_html);
/* The sticky side list also links the closing sections, so a reader can jump straight to the medical review. */
const railEntries = [
  ...toc,
  ...(article.key_takeaways.length > 0 ? [{ id: 'key-takeaways', text: 'Key Takeaways' }] : []),
  ...(review ? [{ id: 'medical-review', text: 'Medical Review' }] : []),
];
const hasTocRail = toc.length > 1;
const diagramSectionId = diagram ? toc.find((entry) => entry.text === diagram.section)?.id : undefined;

const related = await getRelatedArticles(article);

/* Guide-funnel flow: the guide that matches the article's subject, offered once partway through the
   article and once after its last section. In the default flow the sidebar card below does this. */
const guide = guideForArticle(article);

/* Treatment inserts are scoped per category, matched on the SLUG. Each renders
   between the article's closing prose section and Key Takeaways.

   This matched on category.name until 2026-09-19, on the reasoning that a name
   is steadier than a slug. It is the other way round: the name is editorial
   copy shown to readers, so it changes whenever marketing or compliance renames
   a programme — "Peptides & Wellness Therapies" became "Healthy Aging &
   Vitality" that day, which would have silently dropped the insert and the
   Everything Included bar from six articles with no error and a green build.
   The slug is an identifier nobody renames casually, and categoryIcon() already
   depends on it. */
const showTherapies = article.category.slug === 'peptides-wellness';
const showSexualTreatments = article.category.slug === 'sexual-wellness';
const showWeightTreatments = article.category.slug === 'weight-management';
const showHairTreatments = article.category.slug === 'hair-restoration';
const hasTreatments = showTherapies || showSexualTreatments || showWeightTreatments || showHairTreatments;

/* The body in pieces, cut between sections: the diagram after the section it explains, and the guide offer
   partway through, which an article with a treatment section skips (see the note in the markup). */
const guideAt = guide && !hasTreatments ? middleSectionStart(bodyHtml) : undefined;
const diagramAt = diagramSectionId ? sectionEnd(bodyHtml, diagramSectionId) : undefined;
const bodySegments = splitBody(bodyHtml, [
  ...(diagramAt !== undefined ? [{ at: diagramAt, insert: 'diagram' as const }] : []),
  ...(guideAt !== undefined ? [{ at: guideAt, insert: 'guide' as const }] : []),
]);
/* The "Everything Included." bar accompanies every treatment insert, but in
   the rail (client direction) rather than below the insert's product cards.
   Hidden 2026-09-19 to 2026-09-30 while pricing was being settled. */
const showIncludedBar =
  showTherapies || showSexualTreatments || showWeightTreatments || showHairTreatments;

/* Articles in a treatment category start that program's assessment; anything
   else gets the generic CTA. */
const assessmentProgram: ProgramSlug | undefined = showSexualTreatments
  ? 'sexual-wellness'
  : showWeightTreatments
    ? 'weight-loss'
    : showHairTreatments
      ? 'hair-restoration'
      : showTherapies
        ? 'healthy-aging'
        : undefined;
---

<BaseLayout
  title={article.meta_title ?? article.seo_title ?? article.title}
  description={articleDescription}
  jsonLd={jsonLd}
  review={review}
  ogType="article"
  image={cover && { path: cover.src, width: cover.width, height: cover.height, alt: cover.alt }}
>
  <div class="container article-shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/wellness-learning-center">Wellness Learning Center</a></li>
        <li aria-current="page">{article.category.name}</li>
      </ol>
    </nav>

    <header class:list={['article-hero', cover ? 'article-hero--cover' : 'article-hero--plain']}>
      <div class="article-hero__title">
        <a class="article-hero__tag" href={`/wellness-learning-center/#cat-${article.category.slug}`}>{article.category.name}</a>
        <h1 class="article__title">{article.title}</h1>
      </div>

      {cover && (
        <figure
          class:list={['article-cover', `article-cover--${cover.fit}`]}
          style={cover.focus ? `--cover-focus: ${cover.focus}` : undefined}
        >
          <img
            src={cover.src}
            alt={cover.alt}
            width={cover.width}
            height={cover.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="article-hero__meta">
        {review && <MdReviewedBadge variant="byline" review={review} />}
        <p class="article__meta">
          {publishedIso && <span>Published <time datetime={publishedIso}>{longDate(publishedIso)}</time></span>}
          {updatedIso && <span>Last updated <time datetime={updatedIso}>{longDate(updatedIso)}</time></span>}
          <span>{article.reading_minutes} min read</span>
        </p>
      </div>
    </header>

    <div class:list={['article-grid', { 'article-grid--toc': hasTocRail }]}>
      {hasTocRail && <ArticleTocRail entries={railEntries} />}

      <article class="article">

        <div class="article__lede" set:html={article.lede_html} />

        {toc.length > 1 && (
          <nav class="toc" aria-label="In this article">
            <h2 class="toc__title">In this article</h2>
            <ul class="toc__list">
              {toc.map((entry) => (
                <li><a href={`#${entry.id}`}>{entry.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        {/* Products always come before the Smart Patient Guides (Derek, 2026-11-12): an article with a treatment section
            drops the mid-article guide box and keeps only the one after the treatments (guideAt above). */}
        {bodySegments.map((segment, i) => (
          <>
            {segment.html && <div class:list={['prose', { 'prose--cont': i > 0 }]} set:html={segment.html} />}
            {segment.after === 'diagram' && diagram && <ArticleDiagram diagram={diagram} />}
            {segment.after === 'guide' && guide && <GuideArticleCta book={guide} placement="inline" />}
          </>
        ))}

        {showTherapies && <PeptideTherapies />}

        {showSexualTreatments && <SexualTreatmentOptions />}

        {showWeightTreatments && <WeightTreatmentOptions />}

        {showHairTreatments && <HairTreatmentOptions />}

        {article.key_takeaways.length > 0 && (
          <section class="takeaways" aria-labelledby="key-takeaways">
            <h2 class="takeaways__title" id="key-takeaways">Key Takeaways</h2>
            <ul>
              {article.key_takeaways.map((point) => <li>{point}</li>)}
            </ul>
          </section>
        )}

        {review && (
          <section class="review-note" aria-labelledby="medical-review">
            <Fragment set:html={sealMarkup(56, 'md-seal review-note__seal')} />
            <div class="review-note__body">
            <h2 class="review-note__title" id="medical-review">Medical Review</h2>
            <p>
              This article was reviewed and approved for medical accuracy by{' '}
              <a href={reviewerPath(review.reviewer)}>{reviewerName(review.reviewer)}</a>, a licensed physician in{' '}
              {review.reviewer.specialty.toLowerCase()}, on <time datetime={review.reviewedOn}>{formatReviewDate(review.reviewedOn)}</time>.
            </p>
            <p>
              Medical review checks the accuracy of the article&rsquo;s health information. This article is general
              education, not medical advice, and does not replace a conversation with your own healthcare provider.
            </p>
            <p class="review-note__verify">
              <a href={npiRegistryUrl(review.reviewer)} target="_blank" rel="noopener">
                Verify {reviewerShortName(review.reviewer)}&rsquo;s credentials in the NPI Registry<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </p>
            </div>
          </section>
        )}

        {guide && <GuideArticleCta book={guide} placement="end" />}

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-articles">
            <h2 class="related__title" id="related-articles">Related Articles</h2>
            <ul class="related__list">
              {related.map((item) => (
                <li>
                  <a href={item.url_path}>{item.title}</a>
                  {reviewForArticle(item.slug) && <MdReviewedBadge variant="tag" class="related__badge" />}
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <aside class="rail" aria-label="Get started">
        {article.cta_html && (
          <div class="rail__card rail__card--cta">
            <h2 class="rail__title">{article.cta_title}</h2>
            <div class="rail__body" set:html={article.cta_html} />
            <AssessmentCta program={assessmentProgram} class="btn btn--primary rail__btn" arrow />
          </div>
        )}

        {showIncludedBar && <EverythingIncludedStrip stacked />}


        {article.disclaimer_html && (
          <div class="rail__card">
            <h2 class="rail__title rail__title--sm">Medical Disclaimer</h2>
            <div class="rail__body" set:html={article.disclaimer_html} />
          </div>
        )}
      </aside>
    </div>

    <section class="endcta">
      <div class="endcta__text">
        <h2>Ready to Start Your Wellness Journey?</h2>
        <p>
          See if you qualify. One of our licensed healthcare providers will review your answers
          and determine whether you are eligible for treatment.
        </p>
      </div>
      <AssessmentCta program={assessmentProgram} class="btn btn--primary btn--lg" arrow />
    </section>
  </div>
</BaseLayout>

<style>
  .article-shell { padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) var(--space-section); }

  /* ---- Breadcrumb ---- */
  .crumbs ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    list-style: none; padding: 0; margin: 0 0 1.75rem;
    font-size: var(--text-body-size); color: var(--text-muted, #5A6B80);
  }
  .crumbs li + li::before {
    content: '›'; margin-right: 0.5rem; color: #9AAABD;
  }
  .crumbs a { color: var(--text-muted, #5A6B80); }
  .crumbs a:hover { color: var(--blue); }

  /* ---- Two-column reading view ---- */
  .article-grid {
    display: grid; gap: clamp(2rem, 1rem + 4vw, 4rem);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .article-grid { grid-template-columns: minmax(0, 1fr) 20.5rem; }
  }
  /* Wide screens: sticky contents list on the left (ArticleTocRail). 15rem fits the 19px links,
     and the gap tightens so the article keeps about 60+ characters a line at 1280px. */
  @media (min-width: 80rem) {
    .article-grid--toc {
      grid-template-columns: 15rem minmax(0, 1fr) 20.5rem;
      gap: clamp(2.5rem, -2rem + 5vw, 4rem);
    }
  }

  /* ---- Article header ----
     Title on the left, the physician review and dates on the right, and the cover photo under both. On phones
     the photo sits straight under the title, so it is on the first screen. The header sits above the reading
     columns, so the photo can run full width. */
  .article-hero {
    display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "graphic" "meta";
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .article-hero--plain { grid-template-areas: "title" "meta"; }
  .article-hero__title { grid-area: title; min-width: 0; }
  .article-hero__meta { grid-area: meta; min-width: 0; }
  .article-cover { grid-area: graphic; }
  @media (min-width: 62rem) {
    .article-hero--cover, .article-hero--plain {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 2.5rem 3rem; align-items: end;
    }
    .article-hero--cover { grid-template-areas: "title meta" "graphic graphic"; }
    .article-hero--plain { grid-template-areas: "title meta"; }
  }

  /* Category: links to its row on the Learning Center, which opens it. */
  .article-hero__tag {
    display: inline-flex; align-items: center; min-height: 2.5rem; margin-bottom: 1.1rem;
    padding: 0.4rem 1rem; border-radius: var(--radius-pill);
    background: var(--bg-cool-blue); color: var(--blue-hover);
    font-weight: 600; text-decoration: none;
    transition: background-color 200ms var(--ease), color 200ms var(--ease);
  }
  .article-hero__tag:hover { background: var(--blue); color: var(--white); }
  /* At least 1.25 times the section headings below (DESIGN.md, The Title Leads Rule). */
  .article__title {
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.5rem); line-height: 1.1;
    color: var(--navy); text-wrap: balance;
  }
  .article-hero__meta :global(.mdb-byline) { margin-bottom: 0.75rem; }
  .article__meta {
    display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin: 0;
    font-size: var(--text-body-size); color: var(--text-muted, #5A6B80);
  }
  .article__meta time { white-space: nowrap; }

  /* ---- Cover photo ---- */
  .article-cover {
    margin: 0; overflow: hidden; border-radius: var(--radius-lg);
    background: var(--bg-pale-blue);
  }
  .article-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* 'wide': 3:2 on phones, 16:9 from tablet up, cropped at the photo's focus point. 'full': the photo's own shape. */
  .article-cover--wide { aspect-ratio: 3 / 2; }
  .article-cover--wide img { object-position: var(--cover-focus, 50% 20%); }
  @media (min-width: 48rem) { .article-cover--wide { aspect-ratio: 16 / 9; } }
  @media (prefers-reduced-motion: reduce) {
    .article-hero__tag { transition: none; }
  }

  /* ---- Medical review note (end of article) ---- */
  /* Seal as the leading emblem (a colored side stripe is banned by the design rules). */
  .review-note {
    display: flex; align-items: flex-start; gap: 1.1rem;
    margin-top: 2.75rem; padding: 1.5rem 1.75rem;
    border: 1px solid var(--border); border-radius: 14px;
    background: var(--bg-pale-blue);
  }
  .review-note :global(.review-note__seal) { flex: none; margin-top: 0.1rem; }
  .review-note__body { min-width: 0; }
  .review-note time { white-space: nowrap; }
  @media (max-width: 30rem) {
    .review-note { flex-direction: column; gap: 0.75rem; }
  }
  .review-note__title { font-size: calc(var(--text-body-size) * 1.3); color: var(--navy); margin-bottom: 0.75rem; }
  .review-note p { margin-bottom: 0.75rem; }
  .review-note p:last-child { margin-bottom: 0; }
  .review-note a { font-weight: 600; color: var(--blue-on-tint); }
  .review-note a:hover { color: var(--blue-hover); }

  .article__lede { margin-top: 0; }
  .article__lede :global(p) {
    font-size: var(--text-lead); line-height: 1.65; margin-bottom: 1rem;
  }
  .article__lede :global(p:last-child) { margin-bottom: 0; }

  /* ---- Table of contents ---- */
  .toc {
    margin: 2rem 0 2.5rem; padding: 1.25rem 1.5rem;
    background: var(--bg-pale-blue); border-radius: 12px;
  }
  /* The left column takes over on wide screens. */
  @media (min-width: 80rem) {
    .toc { display: none; }
  }
  .toc__title {
    font-size: var(--text-card-title); color: var(--navy); margin-bottom: 0.75rem;
  }
  .toc__list {
    display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem;
    list-style: none; padding: 0; margin: 0;
    font-size: var(--text-body-size);
  }
  /* Dot separators between wrapped links, as in the mockup. */
  .toc__list li + li::before {
    content: '·'; margin-right: 0.9rem; color: #9AAABD;
  }
  .toc__list li { display: flex; align-items: center; }
  .toc__list a { color: var(--blue-on-tint); }
  .toc__list a:hover { color: var(--blue-hover); }

  /* ---- Prose ----
     Every size below is expressed as a ratio of --text-body-size (19px), so
     the article scale hangs off the body text rather than off loose rem
     values. Body copy itself inherits the 19px floor. */
  .prose :global(h2) {
    font-size: calc(var(--text-body-size) * 1.55);
    color: var(--navy);
    margin: 2.5rem 0 0.85rem;
    scroll-margin-top: 6rem; /* clears the sticky nav on anchor jumps */
  }
  .prose :global(h3) {
    font-size: var(--text-h3); color: var(--navy); margin: 1.75rem 0 0.6rem;
  }
  .prose :global(p) { margin-bottom: 1rem; }
  .prose :global(ul) { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  /* Hairline under each section, matching the mockup's rhythm. The second half of a split article
     starts with a section heading, which is its container's first child. */
  .prose :global(h2:not(:first-child)),
  .prose--cont :global(h2:first-child) {
    border-top: 1px solid #E4EAF2; padding-top: 2.25rem;
  }

  /* ---- Key takeaways ---- */
  .takeaways {
    margin-top: 2.75rem; padding: 1.75rem 2rem;
    background: var(--bg-pale-blue); border-radius: 14px;
  }
  .takeaways__title { font-size: calc(var(--text-body-size) * 1.3); color: var(--navy); margin-bottom: 0.9rem; }
  .takeaways ul { margin: 0; padding-left: 1.2rem; }
  .takeaways li { margin-bottom: 0.5rem; }
  .takeaways li:last-child { margin-bottom: 0; }

  /* ---- Related ---- */
  .related { margin-top: 2.75rem; }
  .related__title { font-size: calc(var(--text-body-size) * 1.3); color: var(--navy); margin-bottom: 1rem; }
  .related__list {
    display: grid; gap: 1rem; list-style: none; padding: 0; margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
  }
  .related__list li { padding-left: 1.25rem; border-left: 1px solid #E4EAF2; }
  .related__list li:first-child { padding-left: 0; border-left: 0; }
  .related__list a { font-size: var(--text-body-size); line-height: 1.5; }
  .related__list :global(.related__badge) { display: flex; width: fit-content; margin-top: 0.45rem; font-size: var(--text-note); }

  /* ---- Sticky rail ---- */
  /* minmax(0, 1fr) + min-width: 0: rail cards fit the rail column instead of widening it with their content. */
  .rail { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .rail > * { min-width: 0; }
  @media (min-width: 62rem) {
    .rail { position: sticky; top: 6rem; }
  }
  .rail__card {
    padding: 1.5rem; border-radius: 14px;
    background: var(--bg-pale-blue);
  }
  .rail__card--cta { background: var(--bg-cool-blue); }
  .rail__title { font-size: calc(var(--text-body-size) * 1.2); color: var(--navy); margin-bottom: 0.75rem; }
  .rail__title--sm { font-size: calc(var(--text-body-size) * 1.1); }
  .rail__body :global(p) {
    font-size: var(--text-body-size); line-height: 1.6; margin-bottom: 0.75rem;
  }
  .rail__body :global(p:last-child) { margin-bottom: 0; }
  .rail__btn { width: 100%; margin-top: 1.25rem; }

  /* ---- Closing CTA ---- */
  .endcta {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 1.5rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    background: var(--bg-pale-blue); border-radius: 16px;
  }
  .endcta__text { flex: 1 1 22rem; }
  .endcta h2 { font-size: calc(var(--text-body-size) * 1.55); color: var(--navy); }
  .endcta p { margin-top: 0.5rem; font-size: var(--text-body-size); max-width: 38rem; }
</style>
