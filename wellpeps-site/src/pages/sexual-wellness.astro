---
import BaseLayout from '../layouts/BaseLayout.astro';
import SexHero from '../components/sections/sexual/SexHero.astro';
import SexEducation from '../components/sections/sexual/SexEducation.astro';
import SexProducts from '../components/sections/sexual/SexProducts.astro';
import SexRecommendation from '../components/sections/sexual/SexRecommendation.astro';
import SexFaq from '../components/sections/sexual/SexFaq.astro';
import SexCta from '../components/sections/sexual/SexCta.astro';
import GuideBand from '../components/guides/GuideBand.astro';
import { programAt, startingPrice } from '../lib/seo/catalog';
import { breadcrumbs, faqPage, programService } from '../lib/seo/schema';
const program = programAt('/sexual-wellness/');
const from = startingPrice(program);
const description = `Private ED treatment online with sildenafil or tadalafil, prescribed by a licensed provider if appropriate. From $${from}/month, medication included.`;
const jsonLd = [
  breadcrumbs([{ name: 'Sexual Wellness', path: '/sexual-wellness/' }]),
  programService(program),
  faqPage(program.faqs, program.path),
];
---
<BaseLayout
  title="ED Treatment Online: Sildenafil & Tadalafil | WellPeps"
  description={description}
  jsonLd={jsonLd}
>
  <SexHero />
  <SexEducation />
  <GuideBand program="sexual-wellness" />
  <SexProducts />
  <SexRecommendation />
  <SexFaq />
  <SexCta />
</BaseLayout>
