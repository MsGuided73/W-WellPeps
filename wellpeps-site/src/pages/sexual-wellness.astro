---
import BaseLayout from '../layouts/BaseLayout.astro';
import SexHero from '../components/sections/sexual/SexHero.astro';
import SexEducation from '../components/sections/sexual/SexEducation.astro';
import SexProducts from '../components/sections/sexual/SexProducts.astro';
import SexRecommendation from '../components/sections/sexual/SexRecommendation.astro';
import SexFaq from '../components/sections/sexual/SexFaq.astro';
import SexCta from '../components/sections/sexual/SexCta.astro';
import EbookOffer from '../components/EbookOffer.astro';
import GuideBand from '../components/guides/GuideBand.astro';
import { GUIDE_LANDING_FLOW } from '../config';
import { ebooksFor } from '../data/ebooks';
---
<BaseLayout
  title="Sexual Wellness — WellPeps"
  description="Personalized, provider-guided sexual wellness and ED treatment options to help improve erectile function, confidence, and intimacy—privately from home. Start your free assessment."
>
  <SexHero />
  <SexEducation />
  {GUIDE_LANDING_FLOW && <GuideBand program="sexual-wellness" />}
  <SexProducts />
  <SexRecommendation />
  {!GUIDE_LANDING_FLOW && <EbookOffer books={ebooksFor('sexual-wellness')} variant="band" />}
  <SexFaq />
  <SexCta />
</BaseLayout>
