---
/**
 * Hormone therapy hub. The home page's Hormone Optimization card lands here, and the visitor picks the
 * men's or women's program. (The coming-soon waitlist was removed 2026-11-10: the programs are available.)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { HORMONE_PAGES } from '../data/hormone';
import { breadcrumbs } from '../lib/seo/schema';
const jsonLd = [breadcrumbs([{ name: 'Hormone Therapy', path: '/hormone-optimization/' }])];
const choices = HORMONE_PAGES.map((p) => ({ name: p.name, href: p.path, lead: p.products.subtitle, image: p.hero.image, alt: p.hero.alt }));
---
<BaseLayout
  title="Hormone Therapy for Men & Women | WellPeps"
  description="Provider-guided testosterone therapy for men and menopause hormone therapy for women, prescribed only when a licensed provider decides it is appropriate."
  jsonLd={jsonLd}
>
  <section class="section section--pale-blue hhub">
    <div class="container">
      <div class="section-head reveal">
        <p class="hhub__eyebrow">Hormone Therapy</p>
        <h1>Provider-Guided Hormone Therapy for Men and Women</h1>
        <p>Choose your program to see how it works, the treatment options a licensed provider may consider, and what to expect.</p>
      </div>
      <div class="hchoose reveal">
        {choices.map((c) => (
          <a class="card hchoose__card" href={c.href}>
            <div class="hchoose__media"><img src={c.image} alt={c.alt} width="1800" height="860" /></div>
            <div class="hchoose__body">
              <h2>{c.name}</h2>
              <hr class="rule" />
              <p>{c.lead}</p>
              <span class="arrow-link">Explore Treatment Options <Icon name="arrow-right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hhub { min-height: 60vh; }
  .hhub__eyebrow { color: var(--blue); font-weight: 700; font-size: var(--text-lead); margin-bottom: 0.75rem; }
  .hhub h1 { font-size: var(--text-section-title); font-weight: 700; line-height: 1.1; color: var(--navy); }
  .hchoose {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem;
    max-width: 960px; margin: clamp(2rem, 3vw, 3rem) auto 0;
  }
  .hchoose__card { overflow: hidden; display: flex; flex-direction: column; text-align: center; color: inherit; }
  .hchoose__card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .hchoose__media { aspect-ratio: 16 / 9; overflow: hidden; }
  /* The hero photos fade to white on the left; show their right side, where the people are. */
  .hchoose__media img { width: 100%; height: 100%; object-fit: cover; object-position: 85% center; }
  .hchoose__body { padding: 1.6rem 1.6rem 1.9rem; display: flex; flex-direction: column; align-items: center; }
  .hchoose__body h2 { font-size: var(--text-card-title); font-weight: 600; }
  .hchoose__body .rule { margin-top: 0.9rem; }
  .hchoose__body p { margin-top: 0.9rem; color: var(--text-body); font-size: var(--text-card-body); }
  .hchoose__body .arrow-link { margin-top: 1rem; font-weight: 700; }
  @media (max-width: 720px) { .hchoose { grid-template-columns: 1fr; max-width: 460px; } }
</style>
