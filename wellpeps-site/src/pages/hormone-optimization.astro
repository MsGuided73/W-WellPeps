---
/**
 * Hormone therapy hub. The home page's Hormone Optimization card lands here, and the visitor picks the
 * men's or women's program. (The coming-soon waitlist was removed 2026-11-10: the programs are available.)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { HORMONE_PAGES } from '../data/hormone';
import { breadcrumbs } from '../lib/seo/schema';
const jsonLd = [breadcrumbs([{ name: 'Hormone Therapy', path: '/hormone-optimization/' }])];
// Phone treatment list: every product on both pages, priced ones first ("From $X/mo"), the rest Coming soon.
const treatments = HORMONE_PAGES.flatMap((p) =>
  p.products.items.map((item) => {
    const prices = [item.price, ...(item.plans ?? []).map((pl) => pl.price)].map(Number).filter((n) => Number.isFinite(n) && n > 0);
    return {
      name: item.name,
      who: p.audience === 'men’s' ? 'Men' : 'Women',
      price: prices.length ? `From $${Math.min(...prices)}/mo` : 'Coming soon',
      priced: prices.length > 0,
      href: `${p.path}#ph-treatments`,
      image: item.image,
      tint: p.audience === 'men’s' ? 'var(--ph-t-horm)' : 'var(--ph-t-sex)',
    };
  }),
).sort((a, b) => Number(b.priced) - Number(a.priced));
const choices = HORMONE_PAGES.map((p) => ({ name: p.name, href: p.path, lead: p.products.subtitle, image: p.hero.image, alt: p.hero.alt }));
---
<BaseLayout
  title="Hormone Therapy for Men & Women | WellPeps"
  description="Provider-guided testosterone therapy for men and menopause hormone therapy for women, prescribed only when a licensed provider decides it is appropriate."
  jsonLd={jsonLd}
>
  {/* Phone layout (≤ 767px): two portrait tiles, then every treatment with its price or Coming soon. */}
  <div class="ph-only">
    <div class="ph-page hph2">
      <div class="ph-head"><h1>Hormone therapy, <em>guided by a provider.</em></h1></div>
      <nav class="hph2__portraits" aria-label="Hormone therapy programs">
        {HORMONE_PAGES.map((p) => (
          <a class="hph2__portrait" href={p.path}>
            <img src={p.hero.image} alt={p.hero.alt} aria-hidden="true" width="400" height="500" />
            <span class="hph2__lab"><b>{p.audience === 'men’s' ? 'For men' : 'For women'}</b><Icon name="arrow-right" /></span>
          </a>
        ))}
      </nav>
      <h2 class="ph-htitle">Treatments</h2>
      <div class="hph2__rows">
        {treatments.map((t) => (
          <a class="ph-row" href={t.href} style={`background:${t.tint};margin:0`}>
            <span class="t"><b>{t.name}</b><span>{t.who} · {t.price}</span></span>
            <img src={t.image} alt={`${t.name} treatment`} aria-hidden="true" width="56" height="48" loading="lazy" />
            <Icon name="arrow-right" />
          </a>
        ))}
      </div>
      <p class="ph-fine">Treatment is prescribed only when a licensed provider decides it is appropriate for you. Lab tests are billed separately.</p>
    </div>
  </div>

  <section class="section section--pale-blue hhub ph-hide">
    <div class="container">
      <div class="section-head reveal">
        <p class="hhub__eyebrow">Hormone Therapy</p>
        <h1>Provider-Guided Hormone Therapy for Men and Women</h1>
        <p>Choose your program to see how it works, the treatment options a licensed provider may consider, and what to expect.</p>
      </div>
      <div class="hchoose reveal">
        {choices.map((c) => (
          <a class="card hchoose__card" href={c.href}>
            <div class="hchoose__media"><img src={c.image} alt={c.alt} width="1800" height="860" /></div>
            <div class="hchoose__body">
              <h2>{c.name}</h2>
              <hr class="rule" />
              <p>{c.lead}</p>
              <span class="arrow-link">Explore Treatment Options <Icon name="arrow-right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hhub { min-height: 60vh; }
  .hhub__eyebrow { color: var(--blue); font-weight: 700; font-size: var(--text-lead); margin-bottom: 0.75rem; }
  .hhub h1 { font-size: var(--text-section-title); font-weight: 700; line-height: 1.1; color: var(--navy); }
  .hchoose {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem;
    max-width: 960px; margin: clamp(2rem, 3vw, 3rem) auto 0;
  }
  .hchoose__card { overflow: hidden; display: flex; flex-direction: column; text-align: center; color: inherit; }
  .hchoose__card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .hchoose__media { aspect-ratio: 16 / 9; overflow: hidden; }
  /* The hero photos fade to white on the left; show their right side, where the people are. */
  .hchoose__media img { width: 100%; height: 100%; object-fit: cover; object-position: 85% center; }
  .hchoose__body { padding: 1.6rem 1.6rem 1.9rem; display: flex; flex-direction: column; align-items: center; }
  .hchoose__body h2 { font-size: var(--text-card-title); font-weight: 600; }
  .hchoose__body .rule { margin-top: 0.9rem; }
  .hchoose__body p { margin-top: 0.9rem; color: var(--text-body); font-size: var(--text-card-body); }
  .hchoose__body .arrow-link { margin-top: 1rem; font-weight: 700; }
  @media (max-width: 720px) { .hchoose { grid-template-columns: 1fr; max-width: 460px; } }
  @media (max-width: 767px) {
    .hph2 .ph-head h1 { font-size: 31px; line-height: 1.08; }
    .hph2__portraits { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 6px 12px 0; }
    .hph2__portrait { border-radius: 24px; overflow: hidden; position: relative; height: 252px; background: var(--ph-t-horm); display: block; }
    .hph2__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 82% center; }
    .hph2__lab {
      position: absolute; left: 8px; right: 8px; bottom: 8px; background: rgba(255, 255, 255, 0.94); border-radius: 16px;
      padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; color: var(--ph-ink);
    }
    .hph2__lab b { font: 600 15px/1.15 var(--ph-head); }
    .hph2__lab :global(svg) { width: 16px; height: 16px; }
    .hph2__rows { display: grid; gap: 8px; padding: 2px 12px 0; }
    .hph2 a:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  }
</style>
