---
/**
 * The Smart Patient's Guide Series pages (the guide funnel):
 *
 *   /smart-patient-guides                      the series index (never behind a form)
 *   /smart-patient-guides/<guide>              a guide's landing page, with the email form
 *   /smart-patient-guides/<guide>/thank-you    where the form leads; carries the download
 *   /smart-patient-guides/<guide>/read         the published guide, read online (only once its PDF is published)
 *
 * One route builds all three, because the index needs a rest route to exist at the folder's own
 * address. In the default 'dialog' flow it builds nothing, so none of these addresses exist and
 * nothing links to them: the current flow is untouched. See src/lib/guide-flow.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbs } from '../../lib/seo/schema';
import GuideIndex from '../../components/guides/GuideIndex.astro';
import GuideFeatureLanding from '../../components/guides/GuideFeatureLanding.astro';
import GuideThanks from '../../components/guides/GuideThanks.astro';
import GuideReader from '../../components/guides/GuideReader.astro';
import { ebookPagesFor } from '../../data/ebook-pages';
import { EBOOKS, type Ebook } from '../../data/ebooks';
import { GUIDE_SERIES, guidePageFor } from '../../data/guide-pages';

type Kind = 'index' | 'guide' | 'thanks' | 'read';

export function getStaticPaths() {
  return [
    { params: { path: undefined }, props: { kind: 'index' as Kind } },
    ...EBOOKS.map((book) => ({ params: { path: book.slug }, props: { kind: 'guide' as Kind, book } })),
    ...EBOOKS.map((book) => ({ params: { path: `${book.slug}/thank-you` }, props: { kind: 'thanks' as Kind, book } })),
    // Only a published guide (its `pdf` set, its pages made by scripts/publish-ebook.py) can be read online.
    ...EBOOKS.filter((book) => book.pdf && ebookPagesFor(book.slug)).map((book) => ({ params: { path: `${book.slug}/read` }, props: { kind: 'read' as Kind, book } })),
  ];
}

interface Props {
  kind: Kind;
  book?: Ebook;
}
const { kind, book } = Astro.props;

const meta =
  kind === 'index'
    ? {
        title: 'Smart Patient Guides: Free Healthcare eBooks | WellPeps',
        description: GUIDE_SERIES.indexMeta,
      }
    : kind === 'guide' && book
      ? {
          title: `${book.title} Guide: Free Patient eBook | WellPeps`,
          description: guidePageFor(book.slug).metaDescription,
        }
      : kind === 'read'
        ? {
            title: `Read: The Smart Patient’s Guide to ${book?.title ?? ''} | WellPeps`,
            description: `Read the free Smart Patient’s Guide to ${book?.title ?? ''} online, or download the PDF.`,
          }
        : {
            title: `Your Smart Patient’s Guide to ${book?.title ?? ''} | WellPeps`,
            description: 'Your free Smart Patient’s Guide.',
          };
const readerPages = kind === 'read' && book ? ebookPagesFor(book.slug) : undefined;
---
<BaseLayout
  title={meta.title}
  description={meta.description}
  noindex={kind === 'thanks' || kind === 'read'}
  jsonLd={[breadcrumbs(kind === 'index' || !book
    ? [{ name: 'Smart Patient Guides', path: '/smart-patient-guides/' }]
    : [{ name: 'Smart Patient Guides', path: '/smart-patient-guides/' }, { name: `${book.title} Guide`, path: `/smart-patient-guides/${book.slug}/` }])]}
  pageType={kind === 'index' ? 'CollectionPage' : 'WebPage'}
>
  {kind === 'index' && <GuideIndex />}
  {kind === 'guide' && book && <GuideFeatureLanding book={book} />}
  {kind === 'thanks' && book && <GuideThanks book={book} />}
  {kind === 'read' && book && readerPages && <GuideReader book={book} pages={readerPages} />}
</BaseLayout>
