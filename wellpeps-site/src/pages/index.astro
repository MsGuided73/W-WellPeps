---
import BaseLayout from '../layouts/BaseLayout.astro';
import Fold from '../components/Fold.astro';
import ShopChrome from '../components/ShopChrome.astro';
import ShopShelf from '../components/ShopShelf.astro';
import Hero from '../components/sections/Hero.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';
import HelpFind from '../components/sections/HelpFind.astro';
import Programs from '../components/sections/Programs.astro';
import Journey from '../components/sections/Journey.astro';
import Includes from '../components/sections/Includes.astro';
import WhatsIncluded from '../components/sections/WhatsIncluded.astro';
import Safety from '../components/sections/Safety.astro';
import Insights from '../components/sections/Insights.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import GuideRing from '../components/guides/GuideRing.astro';
import { EBOOKS } from '../data/ebooks';
import { faqs } from '../data/content';
import { toFaqs } from '../lib/seo/catalog';
import { faqPage } from '../lib/seo/schema';
const jsonLd = [faqPage(toFaqs(faqs), '/')];
---
<BaseLayout
  mainClass="page-flow"
  title="WellPeps | Online Weight Loss, Hair Loss, ED & Healthy Aging Care"
  description="Provider-guided telehealth for weight loss, hair loss, ED and healthy aging. One monthly price with medication and shipping. Full refund if not prescribed."
  jsonLd={jsonLd}
>
  <Hero />
  <ShopShelf />
  <Fold label="Why Patients Choose WellPeps"><WhyChoose /></Fold>
  <Fold label="Find a treatment"><HelpFind /></Fold>
  <Fold label="Our Wellness Programs"><Programs /></Fold>
  <Fold label="Your Wellness Journey"><Journey /></Fold>
  <Fold label="What every program includes"><Includes /></Fold>
  <Fold label="One monthly price"><WhatsIncluded tinted /></Fold>
  <Fold label="Safety and privacy"><Safety /></Fold>
  <Fold label="Learning Center"><Insights /></Fold>
  <Fold label="Free guide"><GuideRing books={EBOOKS} /></Fold>
  <Fold label="Common Questions"><Faq /></Fold>
  <Fold label="Get started"><FinalCta /></Fold>
  <ShopChrome />
</BaseLayout>
