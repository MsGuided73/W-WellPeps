---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';
import HelpFind from '../components/sections/HelpFind.astro';
import Programs from '../components/sections/Programs.astro';
import Journey from '../components/sections/Journey.astro';
import Includes from '../components/sections/Includes.astro';
import WhatsIncluded from '../components/sections/WhatsIncluded.astro';
import Safety from '../components/sections/Safety.astro';
import Insights from '../components/sections/Insights.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import GuideRing from '../components/guides/GuideRing.astro';
import { EBOOKS } from '../data/ebooks';
import { faqs } from '../data/content';
import { toFaqs } from '../lib/seo/catalog';
import { faqPage } from '../lib/seo/schema';
const jsonLd = [faqPage(toFaqs(faqs), '/')];
---
<BaseLayout
  title="WellPeps | Online Weight Loss, Hair Loss, ED & Healthy Aging Care"
  description="Provider-guided telehealth for weight loss, hair loss, ED and healthy aging. One monthly price with medication and shipping. Full refund if not prescribed."
  jsonLd={jsonLd}
>
  <Hero />
  <WhyChoose />
  <HelpFind />
  <Programs />
  <Journey />
  <Includes />
  <WhatsIncluded tinted />
  <Safety />
  <Insights />
  <GuideRing books={EBOOKS} />
  <Faq />
  <FinalCta />
</BaseLayout>
