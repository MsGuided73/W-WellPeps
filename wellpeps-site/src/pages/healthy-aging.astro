---
import BaseLayout from '../layouts/BaseLayout.astro';
import PeptideHero from '../components/sections/peptide/PeptideHero.astro';
import PeptideScience from '../components/sections/peptide/PeptideScience.astro';
import PeptideBenefits from '../components/sections/peptide/PeptideBenefits.astro';
import PeptideProducts from '../components/sections/peptide/PeptideProducts.astro';
import PeptideFaq from '../components/sections/peptide/PeptideFaq.astro';
import PeptideCta from '../components/sections/peptide/PeptideCta.astro';
import EbookOffer from '../components/EbookOffer.astro';
import GuideBand from '../components/guides/GuideBand.astro';
import { GUIDE_LANDING_FLOW } from '../config';
import { ebooksFor } from '../data/ebooks';
import { programAt, startingPrice } from '../lib/seo/catalog';
import { breadcrumbs, faqPage, programService } from '../lib/seo/schema';
const program = programAt('/healthy-aging/');
const from = startingPrice(program);
const description = `Provider-guided healthy aging therapies, including sermorelin, NAD+ and glutathione, if a licensed clinician finds them appropriate. From $${from}/month.`;
const jsonLd = [
  breadcrumbs([{ name: 'Healthy Aging & Vitality', path: '/healthy-aging/' }]),
  programService(program),
  faqPage(program.faqs, program.path),
];
---
<BaseLayout
  title="Sermorelin, NAD+ & Wellness Therapies Online | WellPeps"
  description={description}
  jsonLd={jsonLd}
>
  <PeptideHero />
  <PeptideScience />
  {GUIDE_LANDING_FLOW && <GuideBand program="healthy-aging" />}
  <PeptideBenefits />
  <PeptideProducts />
  {!GUIDE_LANDING_FLOW && <EbookOffer books={ebooksFor('healthy-aging')} variant="band" />}
  <PeptideFaq />
  <PeptideCta />
</BaseLayout>
