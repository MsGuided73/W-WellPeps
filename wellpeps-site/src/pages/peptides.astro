---
/**
 * Peptide Therapy (/peptides/), Derek's mockup of 2026-11-17 with his revisions of 2026-11-19: hero, the power and
 * potential of peptides, the six products' cards, understanding peptide therapy, the Peptides guide (coming soon),
 * the brand promises, a closing call to action and questions. The hero, cards, questions and closing band are the hormone pages' sections.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HormoneHero from '../components/sections/hormone/HormoneHero.astro';
import HormoneProducts from '../components/sections/hormone/HormoneProducts.astro';
import HormoneCta from '../components/sections/hormone/HormoneCta.astro';
import HormoneFaq from '../components/sections/hormone/HormoneFaq.astro';
import PeptidesBand from '../components/sections/peptides/PeptidesBand.astro';
import PeptidesValues from '../components/sections/peptides/PeptidesValues.astro';
import PeptidesGuideSoon from '../components/sections/peptides/PeptidesGuideSoon.astro';
import PeptidesPhone from '../components/sections/peptides/PeptidesPhone.astro';
import { PEPTIDES_PAGE_UPDATED, peptidesPage as page } from '../data/peptides';
import { programAt } from '../lib/seo/catalog';
import { breadcrumbs, faqPage, programService } from '../lib/seo/schema';

const program = programAt(page.path);
const jsonLd = [
  breadcrumbs([{ name: page.name, path: page.path }]),
  programService(program),
  faqPage(program.faqs, program.path),
];
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  jsonLd={jsonLd}
  dateModified={`${PEPTIDES_PAGE_UPDATED}T12:00:00Z`}
>
  <div class="ph-only"><PeptidesPhone /></div>
  <div class="ph-hide">
  <HormoneHero page={page} />
  <PeptidesBand band={page.intro} id="power-of-peptides" />
  <HormoneProducts page={page} />
  <PeptidesBand band={page.understanding} id="understanding-peptides" />
  {/* Derek 2026-11-19: "this will be a peptide book, coming soon". */}
  <PeptidesGuideSoon />
  <PeptidesValues values={page.values} />
  {/* Derek's order: the closing call to action comes before the questions on this page. */}
  <HormoneCta page={page} />
  <HormoneFaq page={page} />
  </div>
</BaseLayout>
