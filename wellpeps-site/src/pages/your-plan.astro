---
/**
 * Your plan: what the one monthly price includes, and how to cancel or
 * restart. Linked from the footer and the pricing FAQs: easy to find,
 * deliberately not a marketing page. (Was /membership until 2026-09-30.)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, PATIENT_PORTAL_URL } from '../config';
import { planIncludes, planFinePrint } from '../data/plan';
---
<BaseLayout
  title="Your Plan: What’s Included & How to Cancel — WellPeps"
  description="What your one monthly WellPeps price includes, when you are charged, and how to cancel or restart your plan. No hidden fees, no minimum commitment, no cancellation fee."
>
  <section class="section">
    <div class="container mpage">
      <h1>Your Plan</h1>
      <hr class="rule rule--left" />
      <p class="mpage__lead">
        One monthly price with no hidden fees. You pay nothing unless a clinician prescribes treatment.
        You can cancel anytime, with no minimum commitment and no cancellation fee.
      </p>

      <h2>When you are charged</h2>
      <p>
        You answer your health questions first, and a licensed clinician reviews them. Only if the clinician
        prescribes treatment do you check out, agree to the renewal terms and pay for your first month. If your
        clinician does not prescribe, you never pay. After that first payment, your plan renews monthly on the
        same day of the month until you cancel.
      </p>

      <h2>What&rsquo;s included</h2>
      <ul>
        {planIncludes.map((item) => (
          <li><strong>{item.title}.</strong> {item.body}</li>
        ))}
      </ul>
      <p>{planFinePrint}</p>

      <h2>How to cancel</h2>
      <ol>
        <li>
          Send us a message from your <a href={PATIENT_PORTAL_URL}>patient portal</a>, or email
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> from the address on your account, and tell us
          you would like to cancel.
        </li>
        <li>We will confirm your cancellation in writing within one business day.</li>
      </ol>

      <h2>What happens next</h2>
      <ul>
        <li>Your plan stays active through the month you have already paid for.</li>
        <li>You will not be charged again after we confirm your cancellation.</li>
        <li>
          Medications that have already been ordered or processed for that month&rsquo;s shipment
          cannot be refunded.
        </li>
      </ul>

      <h2>Restarting</h2>
      <p>
        You are welcome back anytime. Sign in to your <a href={PATIENT_PORTAL_URL}>patient portal</a> or
        send us a message, and a licensed provider will review your current health information before
        treatment resumes.
      </p>

      <p class="mpage__help">
        Questions? Email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>. We are happy to help.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .mpage { max-width: 760px; }
  .mpage h1 { font-size: var(--text-section-title); font-weight: 700; }
  .mpage__lead { margin-top: 1.25rem; font-size: var(--text-lead); color: var(--navy); font-weight: 600; }
  .mpage h2 { margin-top: 2.5rem; font-size: var(--text-card-title); font-weight: 700; }
  .mpage p, .mpage li { color: var(--text-body); font-size: var(--text-card-body); line-height: 1.6; }
  .mpage p { margin-top: 0.85rem; }
  .mpage ol, .mpage ul { margin-top: 0.85rem; padding-left: 1.4rem; display: grid; gap: 0.6rem; }
  .mpage a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .mpage__help { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
</style>
