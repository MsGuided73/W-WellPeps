---
/** "Every plan, one monthly price": what the monthly price covers, on the phone layout (plan.ts wording). */
import Icon from '../Icon.astro';
---
<section class="ph-band" aria-labelledby="ph-price-band">
  <h2 id="ph-price-band">Every plan, <em>one monthly price</em></h2>
  <p class="ph-li"><i><Icon name="stethoscope" /></i>Your clinician’s review and follow-ups</p>
  <p class="ph-li"><i><Icon name="pill" /></i>Medication if prescribed, standard shipping included</p>
  <p class="ph-li"><i><Icon name="chat" /></i>Messaging with your care team</p>
  <p class="ph-li ph-li--x"><i><Icon name="flask" /></i>Lab tests are billed separately</p>
  <small>You pay at checkout. If a clinician does not prescribe, we refund you in full. No setup fee, no cancellation fee.</small>
</section>
