---
/**
 * "Every plan, one monthly price": what the monthly price covers. Home page only on phones; treatment
 * pages say it once, in the price box (Derek, 2026-11-20). Larger, simpler lines per his notes; the
 * refund sits in the home page's confidence strip instead.
 */
import Icon from '../Icon.astro';
---
<section class="ph-band" aria-labelledby="ph-price-band">
  <h2 id="ph-price-band">Every plan, <em>one monthly price</em></h2>
  <p class="ph-li"><i><Icon name="stethoscope" /></i>Clinician review and follow-ups</p>
  <p class="ph-li"><i><Icon name="pill" /></i>Prescribed medication and shipping</p>
  <p class="ph-li"><i><Icon name="chat" /></i>Messaging with your care team</p>
  <small>Lab tests for hormone therapy are billed separately.</small>
</section>
