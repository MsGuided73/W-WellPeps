---
/**
 * "How it works" diagram inside a Learning Center article, at the end of the section it explains
 * (src/data/article-heroes.ts).
 *
 * An ordered list, so a screen reader reads it as numbered steps; the discs, lines and arrowheads are
 * decoration. Labels on an arrow describe what passes to the next step. A 'mimic' label is outlined with a
 * dashed line: the treatment standing in for the body's own signal.
 */
import type { ArticleDiagram } from '../data/article-heroes';

interface Props {
  diagram: ArticleDiagram;
}

const { diagram } = Astro.props;
---

<figure class="adiagram" aria-labelledby="adiagram-caption">
  <figcaption class="adiagram__caption" id="adiagram-caption">{diagram.caption}</figcaption>
  <ol class="adiagram__steps">
    {diagram.steps.map((step, i) => (
      <li class="adiagram__step">
        <span class="adiagram__disc" aria-hidden="true">{i + 1}</span>
        <div class="adiagram__body">
          <p class="adiagram__name">{step.name}</p>
          <p>{step.text}</p>
        </div>
        {step.via && (
          <>
            <span class="adiagram__line" aria-hidden="true" />
            <p class="adiagram__via">
              {step.via.map((label) => (
                <span class:list={['adiagram__label', `adiagram__label--${label.kind ?? 'natural'}`]}>
                  {label.term && <strong>{label.term}</strong>} {label.text}
                </span>
              ))}
            </p>
          </>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  .adiagram {
    margin: 2rem 0 2.5rem; padding: clamp(1.4rem, 1rem + 1.5vw, 2.25rem);
    background: var(--bg-pale-blue); border: 1px solid var(--border); border-radius: var(--radius-lg);
  }
  .adiagram__caption {
    font-family: var(--font-serif); font-weight: 700; font-size: var(--text-h3);
    line-height: 1.25; color: var(--navy); margin-bottom: 1.5rem;
  }
  .adiagram__steps { list-style: none; margin: 0; padding: 0; }
  .adiagram__step { display: grid; grid-template-columns: 3.75rem minmax(0, 1fr); column-gap: 1.1rem; }
  /* Raised disc (DESIGN.md): top-lit, a hairline ring and a navy-tinted drop shadow. */
  .adiagram__disc {
    grid-row: 1; grid-column: 1;
    display: grid; place-items: center; width: 3.75rem; height: 3.75rem; border-radius: 50%;
    font: 700 1.35rem/1 var(--font-serif); color: var(--navy);
    background: linear-gradient(180deg, var(--white), var(--bg-cool-blue));
    box-shadow: inset 0 0 0 1.5px var(--border-strong), inset 0 2px 0 var(--white), var(--shadow-sm);
  }
  .adiagram__body { grid-row: 1; grid-column: 2; padding-top: 0.35rem; min-width: 0; }
  .adiagram__body p { margin: 0; line-height: 1.5; }
  .adiagram__name {
    font-family: var(--font-serif); font-weight: 700; font-size: calc(var(--text-body-size) * 1.1);
    line-height: 1.25; color: var(--navy); margin-bottom: 0.25rem !important;
  }
  .adiagram__line {
    grid-row: 2; grid-column: 1; justify-self: center; position: relative;
    width: 2px; min-height: 5rem; margin-block: 0.4rem; background: var(--navy);
  }
  .adiagram__line::after {
    content: ''; position: absolute; left: 50%; bottom: -2px; transform: translateX(-50%);
    border: 7px solid transparent; border-top: 9px solid var(--navy); border-bottom: 0;
  }
  .adiagram__via {
    grid-row: 2; grid-column: 2; align-self: center; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem; padding-block: 0.75rem;
  }
  .adiagram__label {
    display: inline-block; padding: 0.35rem 0.85rem; border-radius: 14px;
    font-size: var(--text-note); line-height: 1.4; color: var(--navy);
  }
  .adiagram__label--natural { background: var(--white); border: 1px solid var(--border-strong); }
  .adiagram__label--mimic { background: var(--white); border: 1.5px dashed var(--blue); }
  @media (max-width: 30rem) {
    .adiagram__step { grid-template-columns: 3rem minmax(0, 1fr); column-gap: 0.9rem; }
    .adiagram__disc { width: 3rem; height: 3rem; font-size: 1.15rem; }
  }
</style>
