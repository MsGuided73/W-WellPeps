---
import Icon from '../../Icon.astro';
import AssessmentCta from '../../AssessmentCta.astro';
import { sexHero } from '../../../data/sexual';
---
<section class="sxhero flow-hero">
  <img class="sxhero__img" src={sexHero.image} width="1500" height="1000" alt={sexHero.alt} fetchpriority="high" />
  <div class="sxhero__wrap">
    <div class="sxhero__copy reveal">
      <h1>
        <span class="sxhero__line">{sexHero.titleLead}</span>
        <span class="sxhero__line sxhero__line--accent">{sexHero.titleAccent}</span>
      </h1>
      <hr class="rule rule--left" />
      <p class="sxhero__lead">{sexHero.lead}</p>
      <div class="sxhero__actions">
        <AssessmentCta program="sexual-wellness" class="btn btn--primary btn--lg">
          <span slot="soon" class="btn btn--primary btn--lg btn--soon"><Icon name="clock" /> Assessments Opening Soon</span>
        </AssessmentCta>
        <a href="#sex-products" class="btn btn--secondary btn--lg">Explore Treatment Options <Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Standard program-hero height (matches Weight / Hair / Peptides) so the
     next section peeks above the fold. */
  .sxhero { position: relative; overflow: hidden; background: #fff; min-height: clamp(520px, 56vw, 780px); display: flex; align-items: center; }
  .sxhero__img {
    position: absolute; top: 0; right: 0; bottom: 0; width: 60vw; height: 100%;
    object-fit: cover; object-position: 50% 20%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.25) 22%, #000 48%);
            mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.25) 22%, #000 48%);
  }
  .sxhero__wrap { position: relative; z-index: 2; width: 100%; max-width: var(--content-max); margin-inline: auto; padding-inline: var(--gutter); }
  .sxhero__copy { max-width: clamp(360px, 48vw, 660px); padding-block: clamp(2.5rem, 4vw, 4.5rem); }
  .sxhero__copy h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.6rem); line-height: 1.04; font-weight: 700; letter-spacing: -0.025em; color: var(--navy); }
  .sxhero__line { display: block; }
  .sxhero__line--accent { color: var(--blue); }
  .sxhero__lead { margin-top: 1.5rem; color: var(--text-body); font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.35rem); max-width: 40ch; }
  .sxhero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; max-width: 480px; }

  @media (max-width: 900px) {
    .sxhero { flex-direction: column; min-height: 0; align-items: stretch; }
    .sxhero__img {
      position: relative; inset: auto; width: 100%; height: clamp(260px, 60vw, 420px); object-position: center 30%;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
              mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    }
    .sxhero__copy { max-width: none; padding-block: 2rem; }
  }

  @media (max-width: 767px) {
    .sxhero__img { height: 92px; }
    .sxhero__copy { padding-block: 0.4rem 0.85rem; }
    .sxhero__copy h1 { font-size: 1.8rem; line-height: 1.08; }
    .sxhero__copy .rule { margin-top: 0.6rem; }
    .sxhero__lead { margin-top: 0.6rem; font-size: 1.1875rem; line-height: 1.4; }
    .sxhero__actions { margin-top: 0.75rem; gap: 0.55rem; max-width: none; flex-direction: column; }
    .sxhero__actions :global(.btn) {
      width: 100%;
      min-height: 48px;
      padding: 0.7rem 1rem;
      font-size: 1.1875rem;
    }
  }
</style>
