---
/**
 * "Hormone therapy starts with understanding your health": the home page's five-step journey
 * (Journey.astro), with Derek's patient photos and the lab-technician step (his note on slide 5).
 */
import type { HormonePage } from '../../../data/hormone';

interface Props {
  page: HormonePage;
}
const { journey } = Astro.props.page;
---
<section class="section section--cream" id="how-it-works">
  <div class="container">
    <div class="section-head hjour__head reveal">
      <h2>{journey.title}</h2>
      <p class="hjour__sub">{journey.subtitle}</p>
      <p>{journey.lead}</p>
    </div>

    <ol class="hjour reveal">
      {journey.steps.map((s, i) => (
        <li class="hjour__step">
          <div class="hjour__media">
            <img src={s.image} width="600" height="792" alt={s.alt} loading="lazy" />
          </div>
          <span class="hjour__num">{i + 1}</span>
          <h3 class="hjour__title">{s.title}</h3>
          <hr class="rule" />
          <p class="hjour__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hjour__head { max-width: 60rem; }
  .hjour__head p { max-width: 760px; margin-inline: auto; }
  .hjour__head .hjour__sub { color: var(--blue); font-weight: 700; }

  .hjour {
    list-style: none; padding: 0; margin-top: clamp(1.75rem, 2.5vw, 2.75rem);
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 2rem;
    container-type: inline-size;
  }
  .hjour__step { text-align: center; position: relative; }
  .hjour__media { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); aspect-ratio: 1 / 1.32; }
  .hjour__media img { width: 100%; height: 100%; object-fit: cover; }
  .hjour__num {
    display: grid; place-items: center;
    width: 46px; height: 46px; margin: 1.4rem auto 0;
    border-radius: 50%; background: var(--bg-wellness); color: var(--navy);
    font-family: var(--font-serif); font-weight: 600; font-size: 1.35rem;
    position: relative; z-index: 1;
  }
  /* Connector line + mid dot between numbers, sized from the column width (as on the home page). */
  .hjour__step:not(:last-child) .hjour__num::after {
    content: ''; position: absolute; top: 50%; left: 100%;
    width: calc((100cqw - 8rem) / 5 + 2rem - 46px);
    height: 2px; background: var(--border-strong); transform: translateY(-50%);
  }
  .hjour__step:not(:last-child) .hjour__num::before {
    content: ''; position: absolute; top: 50%; z-index: 2;
    left: calc(100% + ((100cqw - 8rem) / 5 + 2rem - 46px) / 2);
    width: 7px; height: 7px; border-radius: 50%; background: var(--blue-soft);
    transform: translate(-50%, -50%);
  }
  .hjour__title { font-size: var(--text-card-title); font-weight: 600; margin-top: 1rem; color: var(--navy); line-height: 1.3; }
  .hjour__step .rule { margin-top: 0.75rem; }
  .hjour__body { font-size: var(--text-card-body); color: var(--text-body); margin-top: 0.75rem; line-height: 1.55; }

  @media (max-width: 980px) {
    .hjour { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
    .hjour__step .hjour__num::after, .hjour__step .hjour__num::before { display: none; }
  }
  @media (max-width: 520px) { .hjour { grid-template-columns: 1fr; } }
</style>
