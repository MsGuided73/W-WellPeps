---
/**
 * Closing call to action: the Hair Restoration cream band (photo bleeding off the right, feathered into
 * cream). The button is the shared assessment button: it opens once the program's GEN Health links are
 * in src/config.ts.
 */
import AssessmentCta from '../../AssessmentCta.astro';
import { ASSESSMENT_CTA_LABEL } from '../../../lib/cta';
import type { HormonePage } from '../../../data/hormone';

interface Props {
  page: HormonePage;
}
const { cta, program } = Astro.props.page;
---
<section class="hcta">
  <img class="hcta__img" src={cta.image} width={cta.width} height={cta.height} alt={cta.alt} loading="lazy" />

  <div class="hcta__wrap">
    <div class="hcta__copy reveal">
      <h2>{cta.title}</h2>
      <p class="hcta__lead">{cta.lead}</p>
      {/* Until the program's GEN Health links exist, the button goes to the treatment cards (owner, 2026-11-12). */}
      <AssessmentCta program={program} class="btn btn--primary btn--lg hcta__btn">
        <a slot="soon" href="#hormone-products" class="btn btn--primary btn--lg hcta__btn">{ASSESSMENT_CTA_LABEL}</a>
      </AssessmentCta>
      <p class="hcta__note">{cta.note}</p>
    </div>
  </div>
</section>

<style>
  .hcta {
    position: relative;
    overflow: hidden;
    background: var(--bg-warm-cream);
    display: flex; align-items: center;
    min-height: clamp(460px, 46vw, 660px);
  }

  /* The photos have their own cream fades cropped off (owner, 2026-11-10: the cream covered too much of
     the people), so the photo takes more of the band and only a short feather blends it into the cream. */
  .hcta__img {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 64vw;
    height: 100%;
    object-fit: cover;
    /* Anchored to the top so any crop trims legs, never heads. */
    object-position: 70% top;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.5) 10%, #000 24%);
            mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.5) 10%, #000 24%);
  }

  .hcta__wrap {
    position: relative; z-index: 2;
    width: 100%; max-width: var(--content-max);
    margin-inline: auto; padding-inline: var(--gutter);
  }
  .hcta__copy { max-width: clamp(320px, 34vw, 500px); padding-block: clamp(2.5rem, 4vw, 4.25rem); }
  .hcta__copy h2 { font-size: clamp(1.9rem, 1.2rem + 2.3vw, 3rem); font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
  .hcta__lead { margin-top: 1.1rem; color: var(--text-body); font-size: var(--text-lead); max-width: 32ch; }
  .hcta__btn { margin-top: 1.75rem; align-self: flex-start; }
  .hcta__note { margin-top: 1rem; color: var(--navy); font-weight: 700; font-size: var(--text-note); }

  @media (max-width: 900px) {
    .hcta { flex-direction: column; min-height: 0; align-items: stretch; }
    .hcta__img {
      position: relative; inset: auto; width: 100%; height: clamp(260px, 60vw, 400px);
      object-position: 80% center;
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
              mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    }
    .hcta__copy { max-width: none; padding-block: 2rem 2.75rem; }
  }
</style>
