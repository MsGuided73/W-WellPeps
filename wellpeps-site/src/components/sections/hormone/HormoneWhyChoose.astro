---
/**
 * "Why choose WellPeps for hormone therapy": six icon boxes in a 3 x 2 grid (Derek, round 2 notes,
 * 2026-11-13: "we don't need pictures, we could use icons and boxes"). Same card look as the home
 * page's Why Choose (icon, title, rule, body), with the site's brand line icons.
 */
import Icon from '../../Icon.astro';
import type { HormonePage } from '../../../data/hormone';

interface Props {
  page: HormonePage;
}
const { why } = Astro.props.page;
---
<section class="section section--pale-blue" id="why">
  <div class="container">
    <div class="section-head hwhy__head reveal">
      <h2>{why.title}</h2>
      <p>{why.lead}</p>
    </div>

    <div class="hwhy__grid reveal">
      {why.items.map((c) => (
        <article class="card hwhy__card">
          <img class="hwhy__icon" src={c.icon} width={c.w} height={c.h} alt="" loading="lazy" />
          <h3>{c.title}</h3>
          <hr class="rule" />
          <p>{c.body}</p>
        </article>
      ))}
    </div>

    <p class="hwhy__more reveal">
      <a href="/why-wellpeps/" class="arrow-link">Explore all the reasons Patients choose WellPeps <Icon name="arrow-right" /></a>
    </p>
  </div>
</section>

<style>
  .hwhy__head { max-width: none; }
  .hwhy__head p { max-width: 760px; margin-inline: auto; }

  .hwhy__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem;
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  .hwhy__card { padding: 2.5rem 2rem 2.25rem; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hwhy__card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  /* Same height for every icon so the titles line up across a row; wide icons keep their shape. */
  .hwhy__icon { height: 72px; width: auto; max-width: 110px; object-fit: contain; }
  .hwhy__card h3 { font-size: var(--text-card-title); font-weight: 600; line-height: 1.2; margin-top: 1.4rem; }
  .hwhy__card .rule { margin-top: 0.9rem; }
  .hwhy__card p { margin-top: 0.9rem; color: var(--text-body); font-size: var(--text-card-body); line-height: 1.55; }

  .hwhy__more { text-align: center; margin-top: 2rem; }
  .hwhy__more .arrow-link { font-size: var(--text-lead); font-weight: 700; }

  @media (max-width: 1000px) { .hwhy__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .hwhy__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
