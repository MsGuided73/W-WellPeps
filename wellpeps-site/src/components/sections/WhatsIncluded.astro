---
/**
 * What one monthly price covers. Mounted on the home page and on Weight Loss.
 * Copy lives in src/data/plan.ts. (Was the Membership section until
 * 2026-09-30.)
 */
import Icon from '../Icon.astro';
import { planIntro, planPrice, planIncludes, planFinePrint } from '../../data/plan';

interface Props {
  /** Tinted band, to alternate with the section above it. */
  tinted?: boolean;
}
const { tinted = false } = Astro.props;
---
<section class:list={['section', { 'section--gray': tinted }]} id="whats-included">
  <div class="container">
    <div class="section-head reveal">
      <h2>{planIntro.title}</h2>
      <p>{planIntro.lead}</p>
    </div>

    <div class="mship reveal">
      <div class="mship__price">
        <p class="mship__headline">{planPrice.headline}</p>
        <p class="mship__then">{planPrice.sub}</p>
        <hr class="mship__rule" />
        <p class="mship__note">{planPrice.note}</p>
      </div>

      <ul class="mship__grid" role="list">
        {planIncludes.map((item) => (
          <li class="card mship__card">
            <span class="mship__icon"><Icon name={item.icon} /></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <p class="mship__fine reveal">{planFinePrint}</p>
  </div>
</section>

<style>
  .mship {
    display: grid; grid-template-columns: minmax(280px, 0.8fr) 2fr; gap: 1.75rem;
    margin-top: clamp(2rem, 3vw, 3rem); align-items: stretch;
  }

  .mship__price {
    display: flex; flex-direction: column; justify-content: center;
    padding: 2.5rem 2rem; border-radius: var(--radius);
    background: var(--navy); color: #fff; text-align: center;
    box-shadow: var(--shadow);
  }
  .mship__headline { font-family: var(--font-serif); font-weight: 600; font-size: clamp(2rem, 3vw, 2.6rem); line-height: 1.1; color: #fff; }
  .mship__then { margin-top: 1rem; font-size: var(--text-card-title); font-family: var(--font-serif); font-weight: 600; color: #fff; }
  .mship__rule { width: 56px; height: 2px; border: 0; background: var(--blue); margin: 1.5rem auto; }
  .mship__note { font-size: var(--text-note); color: rgba(255, 255, 255, 0.85); }

  .mship__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .mship__card { display: flex; gap: 1rem; align-items: flex-start; padding: 1.6rem 1.5rem; }
  .mship__icon {
    display: inline-grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%;
    background: var(--medallion-bg); border: 1px solid var(--medallion-ring);
    box-shadow: var(--medallion-shadow); color: var(--blue);
  }
  .mship__icon :global(svg) { width: 24px; height: 24px; filter: var(--icon-shadow); }
  .mship__card h3 { font-size: var(--text-card-title); font-weight: 600; }
  .mship__card p { margin-top: 0.45rem; color: var(--text-body); font-size: var(--text-card-body); }

  .mship__fine { margin: 1.75rem auto 0; max-width: 900px; text-align: center; color: var(--text-muted); font-size: var(--text-note); }

  @media (max-width: 1000px) { .mship { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .mship__grid { grid-template-columns: 1fr; } }
</style>
