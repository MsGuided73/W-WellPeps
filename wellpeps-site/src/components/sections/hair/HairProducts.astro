---
import ProductCard from '../../ProductCard.astro';
import EverythingIncludedStrip from '../../EverythingIncludedStrip.astro';
import { hairProducts, hairProductsIntro } from '../../../data/hair';
import { HAIR_COMING_SOON, PRICE_NOTE } from '../../../config';
---
<section class="section section--gray" id="hair-products">
  <div class="container">
    <div class="hprod__head reveal">
      <h2>{hairProductsIntro.title}</h2>
      <p class="hprod__intro">{hairProductsIntro.intro}</p>
    </div>

    <div class="hprod__grid reveal">
      {hairProducts.map((product) => <ProductCard product={product} comingSoon={HAIR_COMING_SOON} />)}
    </div>

    <p class="hprod__foot reveal">{PRICE_NOTE}</p>
    <p class="hprod__foot hprod__foot--sub reveal">{hairProductsIntro.footnote}</p>

    <EverythingIncludedStrip />
  </div>
</section>

<style>
  /* Full width so the title fits on one line at desktop sizes. */
  .hprod__head { text-align: center; margin-inline: auto; }
  .hprod__head h2 { font-size: var(--text-section-title); font-weight: 700; }
  .hprod__intro { margin-top: 1rem; font-size: var(--text-lead); color: var(--text-body); max-width: 66ch; margin-inline: auto; }

  /* Flex, not grid, so a short last row (five cards = 3 + 2) sits centered. */
  .hprod__grid {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }
  .hprod__grid > :global(*) { flex: 0 1 calc((100% - 3rem) / 3); min-width: 0; }

  .hprod__foot {
    text-align: center; margin-top: 2.5rem;
    color: var(--blue); font-weight: 700; font-size: var(--text-note);
  }

  .hprod__foot--sub { margin-top: 0.75rem; }

  @media (max-width: 1200px) { .hprod__grid > :global(*) { flex-basis: calc((100% - 1.5rem) / 2); } }
  @media (max-width: 620px) {
    .hprod__grid { max-width: 420px; margin-inline: auto; }
    .hprod__grid > :global(*) { flex-basis: 100%; }
  }
</style>
