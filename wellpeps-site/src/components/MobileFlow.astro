---
/**
 * Phone-only page order for the home page and the treatment programs.
 *
 * 767px is the phone range (through a large phone in portrait). It sits under
 * the site's 860px and 900px stacked-hero breakpoints, so tablet, laptop, and
 * desktop keep today's layout. CSS order paints the product block under the
 * hero even before JavaScript. The script then matches DOM order to that
 * paint order so keyboard and screen reader order follow what is on screen.
 * At 768px and up the script does not move anything.
 */
---
<script>
  const MQ = '(max-width: 767px)';
  const main = document.querySelector('main.page-flow');
  if (main) {
    const hero = main.querySelector(':scope > .flow-hero');
    const products = main.querySelector(':scope > .flow-products');
    const leads = [...main.querySelectorAll<HTMLElement>('.flow-lead')];
    let productsMark: Comment | null = null;
    const leadMarks = new Map<HTMLElement, Comment>();

    const placeLeads = (mobile: boolean) => {
      for (const lead of leads) {
        const mark = leadMarks.get(lead);
        if (mobile) {
          if (mark) continue;
          const section = lead.closest('.flow-products');
          const grids = section?.querySelectorAll('.flow-grid');
          const last = grids && grids.length ? grids[grids.length - 1] : null;
          if (!last) continue;
          const ph = document.createComment('flow-lead');
          lead.before(ph);
          leadMarks.set(lead, ph);
          last.after(lead);
        } else if (mark?.parentNode) {
          mark.after(lead);
          mark.remove();
          leadMarks.delete(lead);
        }
      }
    };

    const apply = () => {
      const mobile = window.matchMedia(MQ).matches;
      if (mobile && hero && products) {
        if (hero.nextElementSibling !== products) {
          if (!productsMark) productsMark = document.createComment('flow-products');
          products.before(productsMark);
          hero.after(products);
        }
        placeLeads(true);
        document.documentElement.classList.add('dom-flow');
      } else {
        if (productsMark?.parentNode && products) {
          productsMark.after(products);
          productsMark.remove();
          productsMark = null;
        }
        placeLeads(false);
        document.documentElement.classList.remove('dom-flow');
      }
    };

    apply();
    window.matchMedia(MQ).addEventListener('change', apply);
  }
</script>

<style>
  @media (max-width: 767px) {
    :global(main.page-flow) {
      display: flex;
      flex-direction: column;
    }
    :global(main.page-flow > *) {
      order: 2;
      min-width: 0;
      width: 100%;
    }
    :global(main.page-flow > .flow-hero) { order: 0; }
    :global(main.page-flow > .flow-products) { order: 1; }
    :global(main.page-flow > .flow-products) {
      padding-block: 0.85rem 2rem;
      scroll-margin-top: 5.5rem;
    }

    /* Title, then the product grids, then the longer intro, then the notes.
       The intro stays on the page. It just no longer sits above the cards. */
    :global(.flow-stack) {
      display: flex;
      flex-direction: column;
    }
    :global(.flow-stack > .flow-head) { display: contents; }
    :global(.flow-stack > *) { order: 4; min-width: 0; }
    :global(.flow-stack h2) {
      order: 0;
      width: 100%;
      margin: 0;
      text-align: center;
    }
    :global(.flow-grid) { order: 1; width: 100%; min-width: 0; }
    :global(.flow-lead) {
      order: 2;
      width: 100%;
      margin-top: 1.25rem;
      text-align: center;
    }

    :global(html.dom-flow main.page-flow > *) { order: 0; }
    :global(html.dom-flow) :global(.flow-stack > *),
    :global(html.dom-flow) :global(.flow-stack h2),
    :global(html.dom-flow) :global(.flow-lead),
    :global(html.dom-flow) :global(.flow-grid) { order: 0; }
  }
</style>
