---
/**
 * PrivacyBanner — the first-visit privacy choice. Owner, 2026-11-17: a centered pop-up over a dimmed
 * page (it used to be a bar above the menu). Accept all, Reject all and Choose have equal weight, and it
 * goes away for good once the visitor chooses. It is shown only when the site has an optional tool to
 * ask about, and its wording is written by src/lib/privacy/ui.ts from the tool list.
 *
 * On the privacy and legal pages it stays a slim bar at the top instead, so "Learn more" (and the
 * footer's legal links) open a page the visitor can actually read.
 */
import '../../styles/privacy.css';
import { LEGAL_DOCS } from '../../lib/legal-docs';

const path = Astro.url.pathname.replace(/\/$/, '');
const readingPages = ['/your-privacy-choices', ...LEGAL_DOCS.map((d) => `/${d.path}`)];
// Developer preview pages (/dev-mockups/*, not built for production) need the page usable too.
const inline = readingPages.includes(path) || path.startsWith('/dev-mockups');
// The Cookie Notice section that describes the optional tool(s).
const LEARN_MORE = '/cookie-notice/#3-4-optional-tools-that-run-only-if-you-say-yes';
---
<section
  class:list={['pbanner', inline ? 'pbanner--bar' : 'pbanner--modal']}
  data-privacy-banner
  data-privacy-banner-mode={inline ? 'bar' : 'modal'}
  hidden
  role={inline ? 'region' : 'dialog'}
  aria-modal={inline ? undefined : 'true'}
  aria-labelledby="pbanner-title"
  aria-describedby="pbanner-text"
>
  <div class="pbanner__inner" tabindex="-1" data-privacy-banner-card>
    <div class="pbanner__text">
      <div class="pbanner__head">
        {/* The WellPeps "W" marks the pop-up as ours (owner, 2026-11-19); decorative, the title names it. */}
        {!inline && <img class="pbanner__mark" src="/images/w-mark-v2.png" alt="WellPeps W logo" aria-hidden="true" width="40" height="40" />}
        <h2 class="pbanner__title" id="pbanner-title">Your privacy choices</h2>
      </div>
      <p id="pbanner-text"><span data-pc-banner-text></span> <a class="pbanner__more" href={LEARN_MORE}>Learn more<span class="visually-hidden"> about optional cookies</span></a></p>
    </div>
    {/* The separate health-page consent, in the same step (owner, 2026-11-24). Unticked by default; it applies
        only to Accept all, so Accept all on its own still leaves pages about health topics out. */}
    <label class="pbanner__health">
      <input type="checkbox" data-pc-health-pages />
      <span>Also allow on pages about health topics</span>
    </label>
    <div class="pbanner__buttons">
      <button type="button" class="pc-btn pc-btn--primary" data-pc-action="acceptAll">Accept all</button>
      <button type="button" class="pc-btn pc-btn--primary" data-pc-action="rejectAll">Reject all</button>
      <button type="button" class="pc-btn pc-btn--primary" data-privacy-choose>Choose</button>
    </div>
  </div>
</section>
