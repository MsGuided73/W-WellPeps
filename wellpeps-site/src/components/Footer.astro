---
/**
 * Site footer: legal row, link columns, newsletter, contact and the site disclosure.
 *
 * Adopted from the compliance mockup (docs placement guide, W1). Compared with the old footer:
 *  - legal row: Terms, Privacy, Consumer Health Data Privacy, Notice of Privacy Practices,
 *    Cookie Notice, Accessibility, Your Privacy Choices (opens the privacy panel);
 *  - a "Patient Information" column (medical disclaimer, safety pages, compounded
 *    medications, telehealth consent, patient terms);
 *  - the disclosure paragraph is the draft Block 1 copy (pending counsel);
 *  - removed: the "HIPAA Compliant" badge, "Licensed Providers in All 50 States", the five dead
 *    links and the fixed 2025 year.
 *
 * A link to a page that is not built is left out (src/lib/legal-docs.ts): the draft legal pages
 * exist only in dev and in deployments built with SHOW_DRAFT_PAGES=true, so the footer never
 * shows a dead link, and a column with no links left disappears.
 */
import { CONTACT, CONTACT_ADDRESS, GUIDE_LANDING_FLOW, PATIENT_PORTAL_URL } from '../config';
import { GUIDES_INDEX_PATH } from '../lib/guide-flow';
import { draftPagesEnabledNow, linkVisible } from '../lib/legal-docs';
import LegitScriptSeal from './LegitScriptSeal.astro';

const payments: { label: string; src?: string; caption?: string }[] = [
  { label: 'Visa', src: '/images/payment/logo-visa.png' },
  { label: 'Mastercard', src: '/images/payment/logo-mastercard.png' },
  { label: 'American Express', src: '/images/payment/logo-amex.png' },
  { label: 'Discover', src: '/images/payment/logo-discover.png' },
  { label: 'Apple Pay', src: '/images/payment/logo-apple-pay-v2.png' },
  { label: 'Google Pay', src: '/images/payment/logo-google-pay.png' },
  { label: 'FSA and HSA cards', src: '/images/payment/logo-fsa-hsa.png', caption: 'HSA & FSA' },
];

interface FooterLink { label: string; href: string; note?: string }

const columns: { heading: string; links: FooterLink[] }[] = [
  {
    heading: 'Patient Information',
    links: [
      { label: 'Medical Disclaimer', href: '/medical-disclaimer' },
      { label: 'GLP-1 Safety Information', href: '/safety/glp-1' },
      { label: 'Sexual Health Safety Information', href: '/safety/sexual-health' },
      { label: 'Hair Loss Safety Information', href: '/safety/hair-loss' },
      { label: 'Healthy Aging Safety Information', href: '/safety/healthy-aging' },
      { label: 'Compounded Medications', href: '/compounded-medications' },
      { label: 'Telehealth Consent', href: '/telehealth-consent' },
      { label: 'Patient Terms', href: '/patient-terms' },
      { label: 'All Patient Information', href: '/patient-information' },
    ],
  },
  {
    heading: 'Programs',
    links: [
      { label: 'Weight Management', href: '/weight-loss' },
      { label: 'Healthy Aging & Vitality', href: '/healthy-aging' },
      { label: 'Sexual Wellness', href: '/sexual-wellness' },
      { label: 'Hair Restoration', href: '/hair-restoration' },
      { label: 'Hormone Optimization', href: '/hormone-optimization', note: 'Coming Soon' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'Learning Center', href: '/wellness-learning-center' },
      ...(GUIDE_LANDING_FLOW ? [{ label: 'Smart Patient Guides', href: GUIDES_INDEX_PATH }] : []),
      { label: 'FAQ', href: '/#faq' },
      { label: 'Treatment Process', href: '/#journey' },
      { label: 'Pricing', href: '/#whats-included' },
      { label: 'Manage or Cancel Your Plan', href: '/your-plan' },
      { label: 'Refund & Cancellation', href: '/refund-and-cancellation' },
      { label: 'Shipping & Delivery', href: '/shipping-and-delivery' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About WellPeps', href: '/why-wellpeps' },
      { label: 'How WellPeps Works', href: '/how-wellpeps-works' },
      { label: 'States We Serve', href: '/states-we-serve' },
      { label: 'Contact Us', href: '/contact' },
    ],
  },
];

/** opensPanel links open the privacy panel on any page (see PrivacyRoot.astro). */
const legal: { label: string; href: string; opensPanel?: boolean }[] = [
  { label: 'Terms of Use', href: '/terms-of-use' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Consumer Health Data Privacy Policy', href: '/consumer-health-data-privacy-policy' },
  { label: 'Notice of Privacy Practices', href: '/notice-of-privacy-practices' },
  { label: 'Cookie Notice', href: '/cookie-notice' },
  { label: 'Accessibility', href: '/accessibility' },
  { label: 'Your Privacy Choices', href: '/your-privacy-choices', opensPanel: true },
];

const year = new Date().getFullYear();
// "Mon–Fri, 9am–6pm ET" shown as two lines: the days, then the times.
const [hoursDays, hoursTimes] = CONTACT.hours.includes(', ') ? [CONTACT.hours.slice(0, CONTACT.hours.indexOf(', ') + 1), CONTACT.hours.slice(CONTACT.hours.indexOf(', ') + 2)] : [CONTACT.hours, ''];

const showDrafts = draftPagesEnabledNow();
const visible = (href: string) => linkVisible(href, showDrafts);
const shownColumns = columns
  .map((c) => ({ ...c, links: c.links.filter((l) => visible(l.href)) }))
  .filter((c) => c.links.length > 0);
const shownLegal = legal.filter((l) => visible(l.href));
const statesLive = visible('/states-we-serve');
const healthPolicyLive = visible('/consumer-health-data-privacy-policy');
// The business address is shown once it is confirmed. Until then the placeholder appears
// only where draft pages are enabled, so the live site never prints "[Business address]".
const showAddress = CONTACT_ADDRESS !== '' || showDrafts;
---
<footer class="footer">
  <svg class="footer__wave" viewBox="0 0 1440 260" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 214C240 214 420 176 690 140s470-64 750-90v210H0Z" fill="#CFE0FA" opacity="0.55" />
    <path d="M0 250C260 250 430 214 700 180s500-58 740-78v158H0Z" fill="#BDD4F6" opacity="0.5" />
  </svg>

  <div class="container-wide footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/images/logo-full-v2.png" alt="WellPeps" class="footer__logo" width="600" height="125" />
      </div>

      <div>
        <form class="newsletter" name="newsletter" data-newsletter novalidate>
          <p class="visually-hidden" aria-hidden="true">
            <label for="nl-company">Company</label>
            <input id="nl-company" name="company" tabindex="-1" autocomplete="off" />
          </p>
          <div class="newsletter__row">
            <div class="newsletter__field">
              <svg class="newsletter__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v.3l-9 5.6-9-5.6v-.3Zm0 2.65V17.5A1.5 1.5 0 0 0 4.5 19h15a1.5 1.5 0 0 0 1.5-1.5V9.15l-8.47 5.28a1 1 0 0 1-1.06 0L3 9.15Z" />
              </svg>
              <input type="email" name="email" required placeholder="Enter your email address" aria-label="Email address" />
            </div>
            <button type="submit" class="newsletter__btn">Get Free Wellness Tips Monthly</button>
          </div>
          <p class="newsletter__consent">
            By subscribing, you agree to receive a monthly email from WellPeps and to our
            <a href="/terms-of-use">Terms of Use</a> and <a href="/privacy-policy">Privacy Policy</a>{healthPolicyLive && <Fragment>
            (see also the <a href="/consumer-health-data-privacy-policy">Consumer Health Data Privacy Policy</a>)</Fragment>}.
            Unsubscribe anytime.
          </p>
          <p class="newsletter__error" data-newsletter-error hidden role="alert"></p>
        </form>

        <p class="newsletter__success" data-newsletter-success hidden role="status">
          You’re subscribed — watch your inbox for next month’s wellness tips.
        </p>
      </div>
    </div>

    <hr class="footer__rule" />

    <div class="footer__grid" style={`--footer-cols: ${shownColumns.length}`}>
      {shownColumns.map((col) => (
        <div class="footer__col">
          <h4>{col.heading}</h4>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
                {l.note && <span class="footer__soon">{l.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer__col footer__contact">
        <h4>Contact Us</h4>
        <ul>
          <li>
            <svg class="footer__cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v.3l-9 5.6-9-5.6v-.3Zm0 2.65V17.5A1.5 1.5 0 0 0 4.5 19h15a1.5 1.5 0 0 0 1.5-1.5V9.15l-8.47 5.28a1 1 0 0 1-1.06 0L3 9.15Z" />
            </svg>
            <span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></span>
          </li>
          <li>
            <svg class="footer__cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" />
            </svg>
            <span><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></span>
          </li>
          {showAddress && (
            <li>
              <svg class="footer__cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2.5a7 7 0 0 0-7 7c0 5.1 6.1 11.6 6.36 11.87a.88.88 0 0 0 1.28 0C12.9 21.1 19 14.6 19 9.5a7 7 0 0 0-7-7Zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Z" />
              </svg>
              <span>WellPeps, a Wyoming corporation<br />{CONTACT_ADDRESS !== '' ? CONTACT_ADDRESS : <span class="footer__ph">[Business address]</span>}</span>
            </li>
          )}
          <li>
            <svg class="footer__cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm.75 5v5.2l3.6 2.1-.75 1.3-4.35-2.6V7h1.5Z" />
            </svg>
            <span>Support: {hoursDays}<br />{hoursTimes}<br /><a href={PATIENT_PORTAL_URL}><strong>Patient Portal</strong></a></span>
          </li>
        </ul>

        <h4 class="footer__pay-head">We Accept</h4>
        <ul class="footer__pay" role="list">
          {payments.map((p) => (
            <li class="footer__pay-item">
              <span class="footer__pay-tile">
                {p.src ? <img src={p.src} alt={p.label} width="56" height="38" loading="lazy" /> : <span>{p.label}</span>}
              </span>
              {p.caption && <span class="footer__pay-cap" aria-hidden="true">{p.caption}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="footer__rule footer__rule--legal" />

    <ul class="footer__legal">
      {shownLegal.map((l) => (
        <li>
          <a href={l.href} data-privacy-open={l.opensPanel ? '' : undefined}>
            {l.opensPanel && (
              <svg class="footer__choices-icon" viewBox="0 0 30 14" aria-hidden="true" focusable="false">
                <rect x="0.75" y="0.75" width="28.5" height="12.5" rx="6.25" fill="#fff" stroke="#1576C4" stroke-width="1.5" />
                <path d="M6 7.2l2.3 2.3L12.6 4.6" fill="none" stroke="#1576C4" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M18 4.6l5.2 5M23.2 4.6l-5.2 5" fill="none" stroke="#1576C4" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            )}
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="footer__bottom">
      <div class="footer__legalese">
        <p class="footer__disclaimer">
          WellPeps, a Wyoming corporation, offers education, enrollment and customer support for telehealth care.
          WellPeps is not a medical practice or a pharmacy and does not diagnose, prescribe, compound or dispense.
          Care is provided by independent licensed clinicians, who decide whether a prescription is appropriate. A
          prescription is not guaranteed. Prescriptions are filled and shipped by state-licensed pharmacies.
          Compounded medications are not FDA-approved and have not been evaluated by FDA for safety, effectiveness or
          quality. Availability varies by state{statesLive && <Fragment> (see <a href="/states-we-serve">States We Serve</a>)</Fragment>}. This site is for
          general information and is not medical advice. In an emergency, call 911.
        </p>
        <p class="footer__copy">&copy; {year} WellPeps, a Wyoming corporation. All rights reserved.</p>
      </div>
      {/* LegitScript seal on every page (certified 2026-10-09). No "HIPAA Compliant" badge. */}
      <LegitScriptSeal class="footer__seal" />
    </div>
  </div>
</footer>

<style>
  .footer__pay-head { margin-top: 1.5rem; }
  .footer__col .footer__pay { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: row; flex-wrap: wrap; gap: 0.5rem; max-width: 220px; }
  .footer__col .footer__pay .footer__pay-item { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; width: 56px; } /* the tile width, so a wider caption centres under its card without moving it */
  /* Says what the two-card image stands for (client, 2026-10-02); the image's alt text already does for screen readers. */
  .footer__col .footer__pay-cap { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; line-height: 1.1; letter-spacing: 0; color: var(--navy); white-space: nowrap; }
  .footer__col .footer__pay-tile {
    display: inline-grid; place-items: center; width: 56px; height: 38px;
    border-radius: 6px; overflow: hidden; background: #fff;
    border: 1px solid rgba(8, 43, 89, 0.12);
  }
  .footer__pay-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .footer__pay-tile span { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700; line-height: 1.1; text-align: center; color: var(--navy); padding: 0 4px; }

  /* The comp originally supplied its own indigo blue (#1C60D3) and a near-twin
     navy. Both are now aliased to the global brand tokens so the footer speaks
     the same colour language as the rest of the site — the newsletter button
     is the same action blue as every other CTA.
     --f-muted is the one deliberate exception: the footer sits on a tinted
     gradient (down to #DEE9FC), where --text-muted (#7A8899) drops to 3.0:1
     and fails AA. #5A6A8A holds 4.5:1 against the darkest stop. */
  .footer {
    --f-blue: var(--blue);         /* headings, icons, newsletter button */
    --f-blue-hover: var(--blue-hover);
    --f-navy: var(--navy);         /* link + badge text */
    --f-muted: #5A6A8A;            /* hours, disclaimer, copyright — see above */
    --f-rule: rgba(21, 118, 196, 0.14);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(180deg, #F8FAFE 0%, #F3F7FD 42%, #E7F0FD 76%, #DEE9FC 100%);
    color: var(--f-navy);
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem) 2.5rem;
    font-size: var(--text-footer);
  }
  .footer__inner { position: relative; z-index: 1; }

  .footer__wave {
    position: absolute; inset: auto 0 0 0; z-index: 0;
    width: 100%; height: clamp(140px, 18vw, 260px);
    pointer-events: none;
  }

  .footer a { color: var(--f-navy); transition: color var(--dur) var(--ease); }
  .footer a:hover { color: var(--f-blue); }

  /* ---- Brand + newsletter ---- */
  .footer__top {
    display: grid; grid-template-columns: 1fr 1.35fr; gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .footer__logo { width: clamp(260px, 30vw, 460px); height: auto; display: block; }

  .newsletter__row {
    display: flex; background: #fff;
    border: 1px solid #DCE6F5; border-radius: 14px; overflow: hidden;
    box-shadow: 0 1px 2px rgba(10, 28, 70, 0.05);
  }
  .newsletter__field { display: flex; align-items: center; gap: 0.75rem; flex: 1; padding: 0 1.15rem; }
  .newsletter__icon { width: 24px; height: 24px; color: var(--f-navy); flex: none; }
  .newsletter__field input {
    flex: 1; background: none; border: 0; color: var(--f-navy); font-family: var(--font-sans);
    font-size: var(--text-body-size); padding: 1.05rem 0; min-width: 0;
  }
  .newsletter__field input::placeholder { color: #7B8AA6; }
  .newsletter__field input:focus { outline: none; }
  .newsletter__btn {
    border: 0; cursor: pointer; border-radius: 12px;
    background: var(--f-blue); color: #fff;
    font-family: var(--font-sans); font-weight: 700; font-size: var(--text-body-size); line-height: 1.25;
    padding: 0.95rem 1.9rem; white-space: nowrap;
    transition: background var(--dur) var(--ease);
  }
  .newsletter__btn:hover { background: var(--f-blue-hover); }
  .newsletter__note {
    display: flex; align-items: center; gap: 0.5rem;
    color: var(--f-navy); margin-top: 0.85rem;
  }
  .newsletter__lock { width: 18px; height: 18px; color: var(--f-navy); flex: none; }

  .newsletter__error[hidden], .newsletter__success[hidden] { display: none; }
  .newsletter__error { margin-top: 0.75rem; color: #B3261E; font-weight: 600; }
  .newsletter__success {
    display: flex; align-items: center; gap: 0.5rem;
    margin-top: 0.5rem; color: var(--f-navy); font-weight: 600;
  }

  /* ---- Rules ---- */
  .footer__rule { border: 0; height: 1px; background: var(--f-rule); margin: 2.5rem 0; }
  .footer__rule--legal { margin: 2.5rem 0 1.6rem; }

  /* ---- Link columns ----
     The comp gives Programs a little extra room (it carries the longest
     labels), so the first column is weighted slightly wider than the rest. */
  .footer__grid {
    display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr 1.05fr; gap: 2rem;
  }
  .footer__col h4 {
    font-family: var(--font-sans); font-weight: 700; font-size: var(--text-body-size);
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--f-blue); margin-bottom: 1.4rem;
  }
  .footer__col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .footer__col li { line-height: 1.35; }
  .footer__contact ul { gap: 0.85rem; }
  .footer__soon {
    display: block; margin-top: 0.15rem;
    font-size: var(--text-legal); color: var(--f-blue);
  }

  .footer__contact ul li { display: flex; gap: 0.7rem; align-items: flex-start; line-height: 1.4; }
  .footer__cicon { width: 22px; height: 22px; color: var(--f-blue); margin-top: 1px; flex: none; }
  .footer__contact small { display: block; margin-top: 0.2rem; font-size: var(--text-legal); color: var(--f-muted); }

  /* ---- Legal links ---- */
  .footer__legal {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; align-items: center;
  }
  .footer__legal li { display: flex; align-items: center; }
  .footer__legal li + li::before {
    content: ''; width: 1px; height: 1.05em;
    background: rgba(10, 28, 70, 0.22); margin-inline: 1.25rem;
  }
  .footer__legal a { color: var(--f-navy); font-size: var(--text-legal); }

  /* ---- Disclaimer + trust badges ----
     The comp centres the legalese in the space left of the badges rather
     than on the full container, so the text block flexes and the badges
     hold the right edge. */
  .footer__bottom {
    display: flex; align-items: flex-end; gap: 2rem;
    margin-top: 1.8rem;
  }
  .footer__legalese { flex: 1; min-width: 0; }
  .footer__disclaimer {
    color: var(--f-muted); font-size: var(--text-legal); line-height: 1.65;
    text-align: center; max-width: 62ch; margin: 0 auto;
  }
  .footer__copy { text-align: center; color: var(--f-muted); font-size: var(--text-legal); margin-top: 1.1rem; }

  .footer__badges { display: flex; align-items: center; gap: 1.25rem; flex: none; }
  .footer__badge { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--f-navy); }
  .footer__badge svg { width: 34px; height: 34px; flex: none; }
  .footer__badge-text {
    font-weight: 700; font-size: var(--text-legal); line-height: 1.2;
    letter-spacing: 0.03em; text-transform: uppercase;
  }
  .footer__badge-divider { width: 1px; align-self: stretch; background: rgba(10, 28, 70, 0.2); }

  @media (max-width: 1100px) {
    .footer__grid { grid-template-columns: repeat(3, 1fr); gap: 2.25rem 1.5rem; }
  }
  @media (max-width: 900px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; align-items: center; gap: 1.75rem; }
  }
  @media (max-width: 640px) {
    .newsletter__row { flex-direction: column; }
    .newsletter__btn { border-radius: 0; text-align: center; white-space: normal; }
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__legal { flex-direction: column; align-items: flex-start; gap: 0.85rem; }
    .footer__legal li + li::before { display: none; }
    .footer__badges { flex-wrap: wrap; justify-content: center; }
  }

  /* ---- additions for the compliance footer ---- */
  .footer__grid { grid-template-columns: repeat(var(--footer-cols, 4), 1fr) 1.2fr; }
  .newsletter__consent { margin-top: 0.85rem; color: var(--f-muted); font-size: var(--text-legal); line-height: 1.5; }
  .newsletter__consent a { text-decoration: underline; text-underline-offset: 2px; }
  .footer__ph { color: #8a1f17; background: #fdecec; border-radius: 4px; padding: 0 0.3em; font-weight: 600; }
  .footer__choices-icon { width: 30px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 0.45rem; }
  .footer__legal { gap: 0.6rem 0; }
  .footer__legal li + li::before { margin-inline: 0.8rem; }
  .footer__legal a { font-size: 1rem; }
  .footer__disclaimer { max-width: 100ch; }
  @media (max-width: 1280px) {
    .footer__grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* Phones: the 1280px rule above comes later than the 640px block, so it has to be undone here or
     three columns run off the right edge. min-width: 0 lets grid items (and the email input, whose
     built-in width otherwise sets a minimum) shrink to the screen instead of overflowing it. */
  .footer__top > *, .footer__grid > * { min-width: 0; }
  .newsletter__field input { width: 100%; }
  @media (max-width: 640px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    /* Contact details (email, phone, address) get the full width so they do not break mid-word. */
    .footer__contact { grid-column: 1 / -1; }
  }
  @media (max-width: 340px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { submitSignup } from '../lib/notify';

  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const scope = form.parentElement;
    const success = scope?.querySelector<HTMLElement>('[data-newsletter-success]');
    const errorEl = form.querySelector<HTMLElement>('[data-newsletter-error]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = submit?.textContent ?? '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (errorEl) errorEl.hidden = true;
      if (submit) { submit.disabled = true; submit.textContent = 'Subscribing…'; }

      const result = await submitSignup({
        email: String(data.get('email') ?? ''),
        source: 'footer_newsletter',
        company: String(data.get('company') ?? ''),
      });

      if (result.ok) {
        form.hidden = true;
        if (success) success.hidden = false;
        return;
      }

      if (submit) { submit.disabled = false; submit.textContent = label; }
      if (errorEl) {
        errorEl.textContent = result.message ?? '';
        errorEl.hidden = false;
      }
    });
  });
</script>
