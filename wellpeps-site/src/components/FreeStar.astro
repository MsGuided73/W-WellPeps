---
/**
 * Royal-blue starburst sticker that says FREE. Decorative: the button or link it sits on already
 * says the guide is free, so it is hidden from screen readers. The parent sets its size and place
 * (the SVG fills whatever width it is given and keeps its shape).
 */
const POINTS = 16;
const OUTER = 48;
const INNER = 41;
const burst = Array.from({ length: POINTS * 2 }, (_, i) => {
  const r = i % 2 === 0 ? OUTER : INNER;
  const a = (Math.PI * i) / POINTS - Math.PI / 2;
  return `${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
// One gradient id per star, so several stars on a page never share (or lose) a definition.
const gradId = `free-star-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="free-star" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4F7BF7" />
      <stop offset="1" stop-color="#2146C8" />
    </linearGradient>
  </defs>
  <polygon points={burst} fill={`url(#${gradId})`} stroke="#fff" stroke-width="2.4" stroke-linejoin="round" />
  <circle cx="50" cy="50" r="33" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.2" />
  <text x="50" y="51" text-anchor="middle" dominant-baseline="central" textLength="52" lengthAdjust="spacingAndGlyphs"
    fill="#fff" font-family="var(--font-sans), system-ui, sans-serif" font-weight="800" font-size="23">FREE</text>
</svg>

<style>
  .free-star {
    display: block; width: 100%; height: auto; transform: rotate(-12deg);
    filter: drop-shadow(0 6px 10px rgba(0, 10, 40, 0.4));
  }
</style>
