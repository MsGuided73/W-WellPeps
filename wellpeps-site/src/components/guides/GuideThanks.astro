---
/**
 * A guide's thank-you page (guide-funnel flow): where the form on the landing page leads, and the
 * one place the download lives, so the PDF's address is never on the landing page. It is the best
 * moment to offer the assessment, because the visitor has just raised their hand about a topic.
 *
 * Kept out of search results and not linked from anywhere else. Every guide's page says "Thank You!"
 * (owner, 2026-10-19). A published guide (`pdf` set in src/data/ebooks.ts after Derek approves it, pages
 * made by scripts/publish-ebook.py) says the guide will arrive by email shortly, then offers a plain text
 * link, not a button, to read it online now. An unpublished guide says it will be emailed once published.
 * The email itself is sent by the email service set up separately; this page never says a copy "has been
 * sent".
 */
import Icon from '../Icon.astro';
import AssessmentCta from '../AssessmentCta.astro';
import { guidePageFor } from '../../data/guide-pages';
import { GUIDES_INDEX_PATH, guideReadPath, keepGlpTogether } from '../../lib/guide-flow';
import { ebookPagesFor } from '../../data/ebook-pages';
import type { Ebook } from '../../data/ebooks';

interface Props {
  book: Ebook;
}
const { book } = Astro.props;
const page = guidePageFor(book.slug);
const readable = Boolean(book.pdf && ebookPagesFor(book.slug));
const guideName = `The Smart Patient’s Guide to ${book.title}`;
---
<section class="gthanks">
  <div class="container gthanks__inner">
    <div class="gthanks__card" role="status">
      <span class="gthanks__icon"><Icon name="check" /></span>
      <h1 class="gthanks__title">Thank You!</h1>
      {book.pdf
        ? <p class="gthanks__lead" data-guide-status>You’ll receive <strong>{guideName}</strong> by email shortly. Keep an eye on your inbox, and check your spam folder just in case.</p>
        : <p class="gthanks__lead" data-guide-status>We’ll email <strong>{guideName}</strong> to you as soon as it’s published.</p>}
      {readable && (
        <p class="gthanks__read">Can’t wait? <a href={guideReadPath(book.slug)} data-guide-read>Read the guide online now<Icon name="arrow-right" /></a></p>
      )}
      <p class="gthanks__more"><a href={GUIDES_INDEX_PATH}>Browse all Smart Patient Guides</a></p>
    </div>

    <div class="gthanks__next">
      <h2 set:html={keepGlpTogether(page.thanks.assessmentHeading)} />
      <p>{page.thanks.assessmentBody}</p>
      <AssessmentCta program={page.assessmentProgram} class="btn btn--primary btn--lg" arrow />
    </div>
  </div>
</section>

<style>
  .gthanks {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    background:
      radial-gradient(60rem 30rem at 12% 0%, rgba(46, 168, 247, 0.28), transparent 60%),
      linear-gradient(160deg, #0B3670 0%, var(--navy) 55%, var(--navy-deep) 100%);
  }
  .gthanks__inner { display: grid; gap: 1.75rem; max-width: 46rem; }
  .gthanks__card { display: grid; justify-items: center; gap: 1rem; padding: clamp(1.75rem, 1.2rem + 2.5vw, 3rem); border-radius: 22px; background: #fff; text-align: center; box-shadow: 0 24px 60px rgba(3, 18, 40, 0.4); }
  .gthanks__icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #E6F4EA; color: #1E7B3A; }
  .gthanks__icon :global(svg) { width: 32px; height: 32px; stroke-width: 3; }
  .gthanks__title { font-family: var(--font-serif); font-weight: 600; color: var(--navy); font-size: var(--text-section-title); line-height: 1.12; margin: 0; }
  .gthanks__lead { font-size: var(--text-lead); margin: 0; }
  .gthanks__lead { max-width: 34rem; line-height: 1.55; }
  .gthanks__lead strong { color: var(--navy); }
  /* A plain link, not a button (owner, 2026-10-19): the email is the main way the guide arrives. */
  .gthanks__read { margin: 0; font-size: var(--text-body-size); }
  .gthanks__read a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 700; color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .gthanks__read a :global(svg) { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .gthanks__read a:hover :global(svg) { transform: translateX(3px); }
  .gthanks__read a:focus-visible { outline: 3px solid var(--blue-soft); outline-offset: 3px; border-radius: 4px; }
  .gthanks__more { margin: 0; font-size: 1rem; }
  .gthanks__more a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }

  .gthanks__next { display: grid; justify-items: center; gap: 0.9rem; padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); border-radius: 22px; text-align: center; color: #fff; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); }
  .gthanks__next h2 { font-family: var(--font-serif); font-weight: 600; color: #fff; font-size: var(--text-card-title); margin: 0; }
  .gthanks__next p { margin: 0; max-width: 34rem; color: rgba(255, 255, 255, 0.88); font-size: var(--text-body-size); }
  @media (prefers-reduced-motion: reduce) { .gthanks__read a :global(svg) { transition: none; } }
</style>
