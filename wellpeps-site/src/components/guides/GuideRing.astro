---
/**
 * The home page's Smart Patient's Guide Series section, as a flat sliding strip of covers
 * (guide-funnel flow). (The file keeps its old "ring" name, class names and data attributes, so the
 * pages and the end-to-end check that use it did not have to change.)
 *
 * The covers sit side by side in a looping strip. The guide in the centre is the largest; as the
 * strip slides, the next cover grows as it reaches the centre and the last one shrinks back as it
 * leaves. Drag or swipe it, use the arrows, the dots or the left and right arrow keys, or send a
 * sideways scroll. Clicking a side cover slides it to the centre first; clicking the centre cover
 * opens that guide's landing page. It moves on by itself every few seconds until someone touches it
 * (and never with reduced motion), and a button pauses it.
 *
 * Without JavaScript the strip stays still, laid out by the server: every cover is a plain link.
 *
 * Layout: the strip has a position in guides (src/lib/strip-math.ts). Each card gets --x (its shift,
 * in centre-cover widths) and --s (its scale) from its distance to the centre; CSS turns those into
 * a transform. The script animates the position and repaints the cards every frame.
 */
import Icon from '../Icon.astro';
import FreeStar from '../FreeStar.astro';
import { GUIDE_SERIES } from '../../data/guide-pages';
import { GUIDES_INDEX_PATH, guidePath } from '../../lib/guide-flow';
import { cardLook, wrapOffset } from '../../lib/strip-math';
import type { Ebook } from '../../data/ebooks';

interface Props {
  books: readonly Ebook[];
}
const { books } = Astro.props;
const first = books[0];
/** The cards' resting look with the first guide in the centre (also the no-JavaScript layout). */
const restStyle = (i: number) => {
  const offset = wrapOffset(i, 0, books.length);
  const look = cardLook(offset, books.length);
  return `--i:${i};--x:${look.x};--s:${look.scale};--b:${look.brightness};opacity:${look.opacity};z-index:${look.zIndex}`;
};
const restPos = (i: number) => {
  const d = Math.abs(wrapOffset(i, 0, books.length));
  return d === 0 ? 'front' : d === 1 ? 'near' : 'far';
};
---
{books.length > 0 && (
  <section class="gring-stage" aria-labelledby="gring-title">
    <div class="container">
      <div class="gring-head">
        <p class="gring-pill">{GUIDE_SERIES.name}</p>
        <h2 class="gring-title" id="gring-title">{GUIDE_SERIES.homeTitle[0]} <span>{GUIDE_SERIES.homeTitle[1]}</span></h2>
        <p class="gring-lead">{GUIDE_SERIES.homeBody}</p>
      </div>

      <div class="gring" data-guide-ring role="group" aria-roledescription="carousel" aria-label="Free Smart Patient Guides">
        <div class="gring__viewport" data-ring-viewport>
          <span class="gring__star" aria-hidden="true"><FreeStar sub="eBOOKS" /></span>
          <ul class="gring__track" data-ring-track role="list">
            {books.map((book, i) => (
              <li class="gring__card" data-ring-card data-title={book.title} data-href={guidePath(book.slug)} data-pos={restPos(i)} style={restStyle(i)}>
                <a class="gring__link" href={guidePath(book.slug)} aria-label={`Free guide: ${book.title}`}>
                  <img class="gring__face" src={book.cover} alt="" width="600" height="776" decoding="async" draggable="false" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="gring__controls" data-ring-controls>
          <button type="button" class="gring__btn" data-ring-prev aria-label="Previous guide"><Icon name="arrow-right" /></button>
          <ul class="gring__dots" role="list">
            {books.map((book, i) => (
              <li><button type="button" class="gring__dot" data-ring-dot={i} aria-label={`Show ${book.title}`} aria-current={i === 0 ? 'true' : undefined}></button></li>
            ))}
          </ul>
          <button type="button" class="gring__btn" data-ring-next aria-label="Next guide"><Icon name="arrow-right" /></button>
          <button type="button" class="gring__btn gring__btn--pause" data-ring-pause aria-pressed="false" aria-label="Pause automatic turning">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="gring__pause-icon"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="gring__play-icon"><path d="M8 5v14l11-7z" /></svg>
          </button>
        </div>

        <div class="gring__caption" data-ring-caption aria-live="off">
          <!-- The cover already shows the title; the name stays for screen readers (announced on turn). -->
          <h3 class="gring__name visually-hidden" data-ring-name>{first.title}</h3>
          <a class="gring__cta" data-ring-cta href={guidePath(first.slug)}>{GUIDE_SERIES.homeCta}<Icon name="arrow-right" /></a>
        </div>
      </div>

      <p class="gring__all"><a href={GUIDES_INDEX_PATH}>{GUIDE_SERIES.homeExploreAll}<Icon name="arrow-right" /></a></p>
    </div>
  </section>
)}

<script>
  import { cardLook, guidesPerPixel, indexAt, mod, positionFor, releaseIndex, wrapOffset } from '../../lib/strip-math';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const AUTO_MS = 4200;
  const SLIDE_MS = 850;
  const DRAG_CLICK_SLOP = 6;
  const WHEEL_COOLDOWN_MS = 450;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  document.querySelectorAll<HTMLElement>('[data-guide-ring]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-ring-track]')!;
    const viewport = root.querySelector<HTMLElement>('[data-ring-viewport]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-ring-card]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-ring-dot]')];
    const nameEl = root.querySelector<HTMLElement>('[data-ring-name]')!;
    const ctaEl = root.querySelector<HTMLAnchorElement>('[data-ring-cta]')!;
    const captionEl = root.querySelector<HTMLElement>('[data-ring-caption]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-ring-pause]')!;
    const n = cards.length;

    let position = 0; // in guides; guide k is in the centre when position = k
    let target = 0;   // where the strip is sliding to (the track's --pos, read by the end-to-end check)
    let index = 0;
    let autoplay = !REDUCED;
    let focusedIn = false;
    let resumedByUser = false; // after "turn automatically", focus on the strip no longer holds it still
    let onScreen = true;
    let timer = 0;
    let frame = 0;

    const frontLink = () => cards[index].querySelector('a')!;

    /** Lay every cover out for the strip's current position. */
    function layout() {
      cards.forEach((card, i) => {
        const look = cardLook(wrapOffset(i, position, n), n);
        card.style.setProperty('--x', look.x.toFixed(4));
        card.style.setProperty('--s', look.scale.toFixed(4));
        card.style.setProperty('--b', look.brightness.toFixed(3));
        card.style.opacity = look.opacity.toFixed(3);
        card.style.zIndex = String(look.zIndex);
        card.style.visibility = look.opacity === 0 ? 'hidden' : '';
      });
    }

    /** Which guide is the centre one: the dots, the button under the strip and the screen-reader name. */
    function paint(k: number) {
      index = mod(k, n);
      cards.forEach((card, i) => {
        const d = Math.min(mod(i - index, n), mod(index - i, n));
        card.dataset.pos = d === 0 ? 'front' : d === 1 ? 'near' : 'far';
      });
      dots.forEach((dot, i) => (i === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
      // The button under the strip is the keyboard route to the centre guide, so the covers are not extra tab stops.
      cards.forEach((card) => card.querySelector('a')!.setAttribute('tabindex', '-1'));
      // If focus is on a cover (it was clicked), keep it on whichever cover is now in the centre.
      if (cards.some((c) => c.contains(document.activeElement)) && document.activeElement !== frontLink()) frontLink().focus({ preventScroll: true });
      const card = cards[index];
      nameEl.textContent = card.dataset.title ?? '';
      ctaEl.href = card.dataset.href ?? ctaEl.href;
    }

    function setTarget(p: number) {
      target = p;
      track.style.setProperty('--pos', String(Math.round(p * 1000) / 1000));
    }

    /** Put the strip at a position with no animation (while dragging). */
    function placeAt(p: number) {
      window.cancelAnimationFrame(frame);
      position = p;
      setTarget(p);
      layout();
    }

    /** Slide to guide k by the shortest way; the centre cover grows and the old one shrinks as it goes. */
    function goTo(k: number) {
      setTarget(positionFor(k, n, target));
      paint(k);
      window.cancelAnimationFrame(frame);
      if (REDUCED) { position = target; layout(); return; }
      const from = position;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / SLIDE_MS);
        position = from + (target - from) * easeOut(t);
        layout();
        if (t < 1) frame = window.requestAnimationFrame(step);
      };
      frame = window.requestAnimationFrame(step);
    }

    function syncAuto() {
      window.clearInterval(timer);
      // Autoplay is the default (client, 2026-10-02): resting the mouse on the strip does not hold it;
      // keyboard focus, the pause button, leaving the screen and reduced motion do.
      const held = !resumedByUser && focusedIn;
      const running = autoplay && !held && onScreen && !document.hidden;
      if (running) timer = window.setInterval(() => goTo(index + 1), AUTO_MS);
      captionEl.setAttribute('aria-live', autoplay ? 'off' : 'polite');
      // One fixed label; the pressed state says whether it is paused.
      pauseBtn.setAttribute('aria-pressed', String(!autoplay));
      pauseBtn.classList.toggle('is-paused', !autoplay);
    }
    /** Anyone using the strip takes it over from the automatic sliding. */
    function userTookOver() {
      resumedByUser = false;
      if (!autoplay) return;
      autoplay = false;
      syncAuto();
    }

    // ---- buttons, dots, keys
    root.querySelector('[data-ring-prev]')!.addEventListener('click', () => { userTookOver(); goTo(index - 1); });
    root.querySelector('[data-ring-next]')!.addEventListener('click', () => { userTookOver(); goTo(index + 1); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { userTookOver(); goTo(i); }));
    pauseBtn.addEventListener('click', () => {
      autoplay = !autoplay;
      resumedByUser = autoplay; // the button still has focus and the pointer is on it
      syncAuto();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { userTookOver(); goTo(index + (e.key === 'ArrowRight' ? 1 : -1)); e.preventDefault(); }
      else if (e.key === 'Home') { userTookOver(); goTo(0); e.preventDefault(); }
      else if (e.key === 'End') { userTookOver(); goTo(n - 1); e.preventDefault(); }
    });

    let dragging = false;
    let captured = false;
    let suppressClick = false;
    let startX = 0;
    let startPosition = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0; // pixels per millisecond, smoothed

    // ---- a side cover slides to the centre first; the centre one opens its guide
    cards.forEach((card, i) => {
      card.querySelector('a')!.addEventListener('click', (e) => {
        if (suppressClick) { e.preventDefault(); return; }
        if (i !== index) { e.preventDefault(); userTookOver(); goTo(i); }
      });
    });

    // ---- drag / swipe (vertical page scroll is left to the browser by touch-action: pan-y)
    // offsetWidth is the cover's layout width, which its scale does not change.
    const perPx = () => guidesPerPixel(cards[0].offsetWidth);
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true; captured = false; suppressClick = false; startX = e.clientX; startPosition = position;
      lastX = e.clientX; lastT = performance.now(); velocity = 0;
    });
    viewport.addEventListener('dragstart', (e) => e.preventDefault());
    viewport.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) <= DRAG_CLICK_SLOP && !captured) return;
      if (!captured) {
        captured = true; suppressClick = true; userTookOver();
        viewport.setPointerCapture(e.pointerId);
      }
      const now = performance.now();
      if (now > lastT) velocity = 0.7 * velocity + 0.3 * ((e.clientX - lastX) / (now - lastT));
      lastX = e.clientX; lastT = now;
      // The covers follow the pointer: dragging left brings the next guide in.
      placeAt(startPosition - dx * perPx());
      const live = indexAt(position, n);
      if (live !== index) paint(live);
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      if (captured) {
        // A quick flick carries on by at most one guide; a pointer that stopped before letting go does not flick.
        goTo(releaseIndex({ position, velocity, idleMs: performance.now() - lastT, guidesPerPx: perPx(), n }));
      }
      captured = false;
      // The click that follows a drag must not open a guide.
      window.setTimeout(() => { suppressClick = false; }, 0);
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // ---- sideways scroll (trackpad, tilt wheel) moves it one guide at a time
    let lastWheel = 0;
    viewport.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY) || Math.abs(e.deltaX) < 12) return;
      e.preventDefault();
      const now = performance.now();
      if (now - lastWheel < WHEEL_COOLDOWN_MS) return;
      lastWheel = now;
      userTookOver();
      goTo(index + (e.deltaX > 0 ? 1 : -1));
    }, { passive: false });

    // ---- automatic sliding pauses while the strip is keyboard-focused, off-screen, or the tab is hidden
    root.addEventListener('focusin', (e) => { focusedIn = (e.target as HTMLElement).matches(':focus-visible'); syncAuto(); });
    root.addEventListener('focusout', () => { focusedIn = false; resumedByUser = false; syncAuto(); });
    document.addEventListener('visibilitychange', syncAuto);
    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; syncAuto(); }, { threshold: 0.35 }).observe(root);

    placeAt(0);
    paint(0);
    root.classList.add('is-ready');
    syncAuto();
  });
</script>

<style>
  /* ---------- Stage ---------- */
  .gring-stage {
    position: relative; overflow: hidden; color: #fff;
    /* One screen: the section is the window's height less the 77px header (76px bar + 1px border), so
       the heading, strip, button and link are all in view together. The strip takes whatever height
       the rest leaves (see .gring__viewport). On a very short window it grows rather than clipping. */
    display: flex; flex-direction: column;
    min-height: max(600px, calc(100svh - 77px));
    padding-block: clamp(1.25rem, 3.5vh, 3rem) clamp(1rem, 3vh, 2.5rem);
    background:
      radial-gradient(60rem 30rem at 12% 20%, rgba(46, 168, 247, 0.28), transparent 60%),
      radial-gradient(50rem 30rem at 95% 100%, rgba(21, 118, 196, 0.35), transparent 60%),
      linear-gradient(160deg, #0B3670 0%, var(--navy) 45%, var(--navy-deep) 100%);
  }
  .gring-stage::before { /* faint dot grid */
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.35;
    background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(90deg, #000, transparent 55%);
  }
  .gring-stage > .container { position: relative; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }

  /* ---------- Heading ---------- */
  .gring-head { text-align: center; display: grid; justify-items: center; }
  .gring-pill {
    padding: 0.3em 0.8em; border-radius: 200px; color: #fff; text-align: center;
    font-family: var(--font-sans); text-transform: uppercase;
    font-size: min(clamp(1rem, 0.6rem + 0.9vw, 1.6rem), 3vh); font-weight: 600; letter-spacing: 0.08em; line-height: 1.2;
    background: linear-gradient(180deg, #1B5FAE, #124682);
    border: 1px solid rgba(46, 168, 247, 0.7);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }
  .gring-title {
    margin-top: clamp(0.6rem, 1.6vh, 1.1rem); font-family: var(--font-serif); font-weight: 600; color: #fff;
    font-size: min(clamp(1.75rem, 1.1rem + 2.7vw, 3.75rem), 7vh); line-height: 1.06; letter-spacing: -0.01em;
  }
  /* Two lines: the offer, then the promise. */
  .gring-title span { display: block; }
  .gring-lead { margin: clamp(0.5rem, 1.4vh, 1rem) auto 0; max-width: 62rem; font-size: min(var(--text-lead), 2.8vh); line-height: 1.5; color: rgba(255, 255, 255, 0.86); }

  /* ---------- The strip ---------- */
  .gring {
    position: relative; flex: 1 1 auto; min-height: 0;
    margin-top: clamp(0.5rem, 1.6vh, 1.25rem);
    display: flex; flex-direction: column; align-items: center; gap: clamp(0.6rem, 1.6vh, 1.25rem);
  }
  /* The strip area flexes to the height left over, and the covers are sized from it (cqh/cqw): the
     centre cover's height fills the area less room for its shadow, up to 600px, and its width is
     never more than 36% of the area's width (72% on a phone). The area is at least 56% of the screen's
     height (client 2026-10-13 and 2026-10-16: a bigger, more prominent centre guide), so the section may
     run past one screen. */
  .gring__viewport {
    container-type: size;
    /* Grows from its base: a min-height here would size the covers from the (empty) content. */
    position: relative; width: 100%; flex: 1 0 clamp(320px, 56vh, 620px);
    touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none;
    /* The strip runs off both edges of the section, fading as it goes. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .gring__viewport:active { cursor: grabbing; }
  .gring__viewport::after { /* the soft shadow the centre cover stands over */
    content: ''; position: absolute; left: 50%; bottom: 0; width: min(520px, 70%); height: 1.6rem; transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(0, 10, 30, 0.5), transparent); filter: blur(8px); pointer-events: none;
  }
  .gring__track, .gring__star {
    --h: min(calc(100cqh - 2rem), 600px, calc(36cqw * 776 / 600));
    --w: calc(var(--h) * 600 / 776);
  }
  .gring__track {
    position: absolute; left: 0; right: 0; top: calc(50% - var(--h) / 2 - 0.5rem); height: var(--h); margin: 0; padding: 0; list-style: none;
  }
  /* The FREE eBOOKS coin sits on the top-left corner of the outermost left cover. */
  .gring__star {
    --sw: calc(var(--w) * 0.44);
    position: absolute; z-index: 200; width: var(--sw); pointer-events: none;
    top: calc(50% - var(--h) / 2 - 0.5rem + var(--h) * 0.2 - var(--sw) * 0.62);
    left: max(0px, calc(50% - var(--w) * 1.8 - var(--sw) * 0.45));
  }
  /* --x (shift, in centre-cover widths) and --s (scale) come from the cover's distance to the centre. */
  .gring__card {
    position: absolute; left: 50%; top: 0; width: var(--w); height: var(--h); margin-left: calc(var(--w) / -2);
    transform: translateX(calc(var(--x, 0) * var(--w))) scale(var(--s, 1));
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  .gring__link { position: absolute; inset: 0; display: block; border-radius: 3px 6px 6px 3px; }
  .gring__link:focus-visible { outline: 3px solid var(--blue-soft); outline-offset: 6px; }
  .gring__face {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    border-radius: 3px 6px 6px 3px;
    box-shadow: 0 18px 38px rgba(0, 8, 28, 0.45), 3px 0 0 #E9EDF3, 5px 0 0 #B9C3D0;
    /* Side covers dim with their distance from the centre. */
    filter: brightness(var(--b, 1));
  }
  /* A soft pool of light behind the centre cover, so it reads as the one on offer. */
  .gring__card::before {
    content: ''; position: absolute; inset: -16% -30%; z-index: -1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(120, 196, 255, 0.38), transparent);
    opacity: 0; transition: opacity 0.4s ease;
  }
  .gring__card[data-pos='front']::before { opacity: 1; }
  .gring__card[data-pos='front'] .gring__face {
    box-shadow: 0 26px 56px rgba(0, 8, 28, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.18), 3px 0 0 #E9EDF3, 5px 0 0 #B9C3D0;
  }
  @media (prefers-reduced-motion: reduce) { .gring__card::before { transition: none; } }

  /* ---------- Controls and caption ---------- */
  .gring__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; visibility: hidden; }
  .gring.is-ready .gring__controls { visibility: visible; }
  .gring__btn {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; cursor: pointer; color: #fff;
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.35);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .gring__btn:hover { background: rgba(255, 255, 255, 0.22); }
  .gring__btn:focus-visible { outline: 3px solid var(--blue-soft); outline-offset: 3px; }
  .gring__btn :global(svg) { width: 22px; height: 22px; }
  .gring__btn[data-ring-prev] :global(svg) { transform: scaleX(-1); }
  .gring__btn--pause { width: 40px; height: 40px; margin-left: 0.5rem; }
  .gring__btn--pause svg { width: 18px; height: 18px; fill: currentColor; }
  .gring__play-icon { display: none; }
  .gring__btn--pause.is-paused .gring__play-icon { display: block; }
  .gring__btn--pause.is-paused .gring__pause-icon { display: none; }
  .gring__dots { display: flex; gap: 0; list-style: none; margin: 0; padding: 0; }
  /* The dot is 12px; its button is 24px (WCAG 2.2 target size) with no overlap between neighbours. */
  .gring__dot { position: relative; width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; }
  .gring__dot::before { content: ''; position: absolute; left: 6px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: rgba(255, 255, 255, 0.35); transition: background 0.2s ease, transform 0.2s ease; }
  .gring__dot[aria-current='true']::before { background: #fff; transform: scale(1.3); }
  .gring__dot:focus-visible { outline: 3px solid var(--blue-soft); outline-offset: 0; border-radius: 50%; }

  .gring__caption { display: grid; justify-items: center; gap: 1rem; text-align: center; }
  .gring__name { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-card-title); color: #fff; line-height: 1.2; min-height: 1.2em; }
  .gring__cta {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 1rem 1.8rem; border-radius: 999px;
    font-family: var(--font-sans); font-weight: 700; font-size: 1.125rem; letter-spacing: 0.02em; text-transform: uppercase; color: var(--navy);
    background: linear-gradient(180deg, #FFFFFF, #E4F2FD);
    box-shadow: 0 10px 26px rgba(46, 168, 247, 0.35), inset 0 -2px 0 rgba(21, 118, 196, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
