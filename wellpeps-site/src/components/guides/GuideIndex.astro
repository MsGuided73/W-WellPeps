---
/**
 * The Smart Patient's Guide Series page (guide-funnel flow): every guide in one place, never behind a
 * form. People browse here; the form is on each guide's own page. It is meant to be found by search
 * and linked from social posts, the Learning Center and the home page ring.
 */
import Icon from '../Icon.astro';
import AssessmentCta from '../AssessmentCta.astro';
import FreeStar from '../FreeStar.astro';
import GuideBook from './GuideBook.astro';
import { GUIDE_SERIES } from '../../data/guide-pages';
import { EBOOKS } from '../../data/ebooks';
import { guidePath } from '../../lib/guide-flow';
---
<section class="gidx-hero">
  <span class="gidx-hero__star" aria-hidden="true"><FreeStar /></span>
  <div class="container gidx-hero__inner">
    <p class="gidx-eyebrow">{GUIDE_SERIES.indexEyebrow}</p>
    <h1 class="gidx-title">{GUIDE_SERIES.indexTitle[0]}<span>{GUIDE_SERIES.indexTitle[1]}</span></h1>
    <p class="gidx-lead">{GUIDE_SERIES.indexBody}</p>
  </div>
</section>

<section class="gidx-grid-section" aria-label="All Smart Patient Guides">
  <div class="container">
    <ul class="gidx-grid" role="list">
      {EBOOKS.map((book, i) => (
        <li class="gidx-card">
          <a class="gidx-card__book" href={guidePath(book.slug)} tabindex="-1" aria-hidden="true">
            <GuideBook src={book.cover} star={false} loading={i < 3 ? 'eager' : 'lazy'} />
          </a>
          <!-- The cover carries the title, so there is no separate title or blurb (client, 2026-10-02). -->
          <a class="gidx-card__link" href={guidePath(book.slug)} aria-label={`${GUIDE_SERIES.viewGuide}: The Smart Patient’s Guide to ${book.title}`}>{GUIDE_SERIES.viewGuide}<Icon name="arrow-right" /></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="gidx-ready" aria-labelledby="gidx-ready-title">
  <div class="container gidx-ready__inner">
    <h2 id="gidx-ready-title">Ready to explore treatment?</h2>
    <AssessmentCta class="btn btn--primary btn--lg" arrow />
  </div>
</section>

<style>
  .gidx-hero {
    position: relative; overflow: hidden; color: #fff; text-align: center;
    padding-block: clamp(3.5rem, 6vw, 6rem);
    background:
      radial-gradient(60rem 30rem at 12% 20%, rgba(46, 168, 247, 0.28), transparent 60%),
      radial-gradient(50rem 30rem at 95% 100%, rgba(21, 118, 196, 0.35), transparent 60%),
      linear-gradient(160deg, #0B3670 0%, var(--navy) 45%, var(--navy-deep) 100%);
  }
  .gidx-hero__star { position: absolute; z-index: 1; top: clamp(1rem, 3vw, 2.5rem); left: clamp(0.75rem, 4vw, 4rem); width: clamp(88px, 13vw, 190px); pointer-events: none; }
  .gidx-hero__inner { position: relative; display: grid; justify-items: center; }
  .gidx-eyebrow {
    padding: 0.35em 0.9em; border-radius: 200px; font-family: var(--font-sans); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;
    font-size: clamp(1rem, 0.85rem + 0.7vw, 1.5rem); line-height: 1.25; background: linear-gradient(180deg, #1B5FAE, #124682); border: 1px solid rgba(46, 168, 247, 0.7);
  }
  .gidx-title { margin-top: 1.2rem; font-family: var(--font-serif); font-weight: 600; color: #fff; font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.2rem); line-height: 1.08; letter-spacing: -0.01em; }
  .gidx-title span { display: block; color: var(--blue-soft); }
  .gidx-lead { margin-top: 1.2rem; max-width: 48rem; font-size: var(--text-lead); line-height: 1.55; color: rgba(255, 255, 255, 0.88); }

  .gidx-grid-section { padding-block: clamp(3rem, 5vw, 5rem); background: var(--bg-pale-blue); }
  /* Flex, so a last row with fewer cards is centred rather than left-aligned with a gap. */
  .gidx-grid { --gap: clamp(1.5rem, 3vw, 2.5rem); list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(2rem, 4vw, 3.25rem) var(--gap); }
  .gidx-card { flex: 0 1 calc((100% - 2 * var(--gap)) / 3); min-width: 0; display: grid; align-content: start; justify-items: center; text-align: center; gap: 0.6rem; }
  .gidx-card__book { display: block; width: min(340px, 86%); padding-right: 0.9rem; margin-bottom: 1.4rem; }
  .gidx-card__book:focus-visible { outline: 3px solid var(--blue); outline-offset: 8px; }
  .gidx-card__book:hover :global(.gbook), .gidx-card__book:focus-visible :global(.gbook) { transform: perspective(1400px) rotateY(-6deg) rotateX(1deg) translateY(-6px); }
  .gidx-card__link { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.5rem; color: #0F62A8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.0625rem; } /* darker than --blue: it sits on the pale-blue section, not a white card (contrast) */
  .gidx-card__link :global(svg) { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .gidx-card__link:hover :global(svg) { transform: translateX(3px); }

  .gidx-ready { padding-block: clamp(2.25rem, 4vw, 3.5rem); background: #fff; }
  .gidx-ready__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.25rem 2rem; text-align: center; }
  .gidx-ready h2 { font-family: var(--font-serif); font-weight: 600; color: var(--navy); font-size: var(--text-card-title); margin: 0; }

  @media (max-width: 980px) { .gidx-card { flex-basis: calc((100% - var(--gap)) / 2); } }
  @media (max-width: 620px) {
    .gidx-card { flex-basis: 100%; }
    .gidx-hero__inner { padding-top: 3.5rem; } /* room above the tag for the star */
  }
  @media (prefers-reduced-motion: reduce) { .gidx-card__link :global(svg) { transition: none; } }
</style>
