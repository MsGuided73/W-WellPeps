---
/**
 * The full landing layout for a Smart Patient Guide (client mock 2026-10-12, revised to Derek's
 * landing-page notes 2026-10-16 and 2026-10-19). Five sections, the set-up every guide page follows:
 *
 *   1. Hero + sign-up   headline, copy and form on the left (55%), the eBook cover on the right (45%);
 *                       the form's button is always on the first screen (Derek 2026-10-19)
 *   2. Trust strip      free, education first, your email your choice
 *   3. Inside the guide what is in it, with a lifestyle photo
 *   4. More free guides the other guides in the series, by cover, each opening its own landing page
 *   5. Final call       one headline, one button that scrolls back to the form (no second form)
 *
 * One type scale for the whole page (Derek 2026-10-19): h1 up to 52px, every section h2 up to 40px,
 * sub-heads 22px, body 18px, labels 14px.
 *
 * The words live in src/data/guide-pages.ts (GUIDE_FEATURE_COPY and the guide's own entry), which
 * also notes what was left out of the mock and why. Every guide uses this layout since 2026-10-18.
 */
import Icon from '../Icon.astro';
import GuideBook from './GuideBook.astro';
import GuideLeadForm from './GuideLeadForm.astro';
import LegitScriptSeal from '../LegitScriptSeal.astro';
import { GUIDE_FEATURE_COPY as C, guidePageFor } from '../../data/guide-pages';
import { EBOOKS, type Ebook } from '../../data/ebooks';
import { GUIDES_INDEX_PATH, guidePath, keepGlpTogether } from '../../lib/guide-flow';
import { ebookPagesFor } from '../../data/ebook-pages';

interface Props {
  book: Ebook;
}
const { book } = Astro.props;
const page = guidePageFor(book.slug);
const feature = page.feature;
const [photoW, photoH] = feature.photoSize;
const formId = `gf-form-${book.slug}`;
const coverAlt = `Cover of The Smart Patient’s Guide to ${book.title}`;
const library = EBOOKS.filter((b) => b.slug !== book.slug).slice(0, C.librarySize);
// A published guide shows when it was published and last updated (owner, 2026-10-19); kept out of the hero,
// whose form has to stay on the first screen.
const published = book.pdf ? ebookPagesFor(book.slug) : undefined;
const longDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="gf-hero">
  <div class="container gf-hero__inner">
    <div class="gf-hero__head">
      <p class="gf-eyebrow">{C.eyebrow}</p>
      <h1 class="gf-title">{C.titleLead} <span set:html={keepGlpTogether(book.title)} /></h1>
      <p class="gf-sub" set:html={keepGlpTogether(`${page.headline[0]} ${page.headline[1]}`)} />
    </div>
    <p class="gf-intro" set:html={keepGlpTogether(page.intro)} />

    <div class="gf-hero__book">
      <span class="gf-hero__glow" aria-hidden="true"></span>
      <GuideBook src={book.cover} alt={coverAlt} loading="eager" />
    </div>

    <div class="gf-hero__form" id={formId}>
      <GuideLeadForm book={book} tagline={C.formTagline} />
    </div>
  </div>
</section>

<section class="gf-trust" aria-label="About this guide">
  <div class="container gf-trust__inner">
    <LegitScriptSeal class="gf-trust__seal" />
    <ul class="gf-trust__list" role="list">
      {C.trust.map((t) => (
        <li><span class="gf-trust__icon"><Icon name={t.icon} /></span><span><strong>{t.title}</strong>{t.body}</span></li>
      ))}
    </ul>
  </div>
</section>

<section class="gf-inside" aria-labelledby="gf-inside-title">
  <div class="container gf-inside__inner">
    <figure class="gf-inside__photo">
      <img src={feature.photo} alt={feature.photoAlt} width={photoW} height={photoH} loading="lazy" decoding="async" />
    </figure>

    <div class="gf-inside__copy">
      <p class="gf-label">{C.insideEyebrow}</p>
      <h2 class="gf-h2" id="gf-inside-title" set:html={keepGlpTogether(feature.insideTitle)} />
      <p class="gf-lead" set:html={keepGlpTogether(feature.insideLead)} />
      <ul class="glp-inside gf-checks" role="list">
        {page.inside.map((item) => (
          <li><span class="gf-checks__tick"><Icon name="check" /></span><span set:html={keepGlpTogether(item)} /></li>
        ))}
      </ul>
      {published && (
        <p class="gf-dates">
          <span>Published <time datetime={published.publishedOn}>{longDate(published.publishedOn)}</time></span>
          <span aria-hidden="true">&middot;</span>
          <span>Last updated <time datetime={published.updatedOn}>{longDate(published.updatedOn)}</time></span>
        </p>
      )}
    </div>
  </div>
</section>

<section class="gf-library" aria-labelledby="gf-library-title">
  <div class="container">
    <h2 class="gf-h2 gf-h2--center" id="gf-library-title">{C.libraryTitle}</h2>
    <p class="gf-library__sub">{C.librarySub}</p>
    <p class="gf-library__lead">{C.libraryLead}</p>
    <ul class="gf-library__grid" role="list">
      {library.map((b) => (
        <li class="gf-library__card">
          <!-- Each card opens that guide's own landing page, where the email form is; never the PDF. -->
          <a href={guidePath(b.slug)} class="gf-library__link">
            <span class="gf-library__cover"><GuideBook src={b.cover} alt="" /></span>
            <span class="gf-library__body">
              <span class="gf-library__series">The Smart Patient’s Guide to</span>
              <span class="gf-library__title" set:html={keepGlpTogether(b.title)} />
              <span class="gf-library__more">{C.libraryLink}<span class="visually-hidden">: {b.title}</span><Icon name="arrow-right" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="gf-library__all"><a href={GUIDES_INDEX_PATH}>{C.libraryAll}<Icon name="arrow-right" /></a></p>
  </div>
</section>

<section class="gf-close" aria-labelledby="gf-close-title">
  <div class="container gf-close__inner">
    <h2 class="gf-h2 gf-close__title" id="gf-close-title">{C.closeTitle}</h2>
    <p class="gf-close__sub">{C.closeSub}</p>
    <p class="gf-close__body" set:html={keepGlpTogether(feature.closeBody)} />
    <!-- Scrolls back up to the one sign-up form and puts the cursor in the email field. -->
    <a href={`#${formId}`} class="gf-close__btn" data-gf-to-form>{C.closeButton}<Icon name="arrow-right" /></a>
    <p class="gf-close__note">{C.closeNote}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-gf-to-form]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      const email = target?.querySelector<HTMLInputElement>('[data-guide-email]');
      if (!target || !email) return;
      e.preventDefault();
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
      email.focus({ preventScroll: true });
    });
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .gf-hero {
    position: relative; overflow: hidden; color: #fff; isolation: isolate;
    background:
      radial-gradient(44rem 32rem at 74% 45%, rgba(46, 168, 247, 0.24), transparent 62%),
      linear-gradient(160deg, #0B3670 0%, var(--navy) 50%, var(--navy-deep) 100%);
  }
  /* 55% headline and form, 45% the cover. The whole form, button included, has to fit on the first
     screen of a 1366 x 768 laptop, so the spacing here is tight on purpose. */
  .gf-hero__inner {
    display: grid; grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    grid-template-areas: 'head book' 'intro book' 'form book';
    column-gap: clamp(1.5rem, 4vw, 4rem); row-gap: 0.6rem; align-items: start;
    padding-block: clamp(1.25rem, 2.2vw, 2.5rem);
  }
  .gf-hero__head { grid-area: head; max-width: 42rem; }
  .gf-hero__form { grid-area: form; max-width: 40rem; margin-top: 0.5rem; scroll-margin-top: 110px; }
  .gf-hero__book {
    grid-area: book; align-self: center; justify-self: start; position: relative;
    width: min(78%, 360px); margin: 1.5rem 0 1.5rem clamp(0rem, 3vw, 3rem);
  }

  .gf-eyebrow { font-family: var(--font-sans); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue-soft); }
  .gf-title {
    margin-top: 0.45rem; font-family: var(--font-serif); font-weight: 700; color: #fff; text-wrap: balance;
    font-size: clamp(2.125rem, 1.45rem + 2.1vw, 3.25rem); line-height: 1.08; letter-spacing: -0.01em;
  }
  .gf-sub {
    margin-top: 0.6rem; font-family: var(--font-serif); font-weight: 600; color: var(--blue-soft); text-wrap: balance;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem); line-height: 1.3;
  }
  .gf-intro { grid-area: intro; max-width: 42rem; font-size: 1.125rem; line-height: 1.55; color: rgba(255, 255, 255, 0.9); }

  /* A soft pool of light behind the cover, and a wide shadow under it. */
  .gf-hero__glow { position: absolute; inset: -14% -22% -10% -16%; z-index: 0; border-radius: 50%; background: radial-gradient(closest-side, rgba(120, 196, 255, 0.3), transparent); }
  .gf-hero__book :global(.gbook) { position: relative; z-index: 1; filter: drop-shadow(0 30px 40px rgba(2, 12, 32, 0.55)); }

  /* ---------- Trust strip ---------- */
  .gf-trust { background: #F3F7FC; border-bottom: 1px solid #E1E9F3; }
  .gf-trust__inner { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 3rem); padding-block: clamp(1.6rem, 2.5vw, 2.25rem); }
  .gf-trust__list { list-style: none; margin: 0; padding: 0; flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .gf-trust__list li { display: flex; align-items: center; gap: 0.95rem; font-size: 1.0625rem; line-height: 1.4; color: var(--text-body); }
  .gf-trust__list strong { display: block; margin-bottom: 0.1rem; font-family: var(--font-serif); font-weight: 600; font-size: 1.3125rem; line-height: 1.25; color: var(--navy); }
  .gf-trust__icon { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: #fff; color: var(--blue); box-shadow: 0 4px 12px rgba(8, 43, 89, 0.08); }
  .gf-trust__icon :global(svg) { width: 27px; height: 27px; }

  /* ---------- Shared section type ---------- */
  .gf-label { font-family: var(--font-sans); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); }
  .gf-h2 { margin-top: 0.5rem; font-family: var(--font-serif); font-weight: 700; color: var(--navy); font-size: clamp(1.875rem, 1.35rem + 1.5vw, 2.5rem); line-height: 1.12; text-wrap: balance; }
  .gf-h2--center { text-align: center; }
  .gf-lead { margin-top: 0.9rem; max-width: 38rem; color: var(--text-body); font-size: 1.125rem; line-height: 1.6; }

  /* ---------- Inside the guide ---------- */
  .gf-inside { padding-block: clamp(3rem, 6vw, 5rem); background: #fff; }
  .gf-inside__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.75rem, 4vw, 4rem); align-items: center; }
  /* The photo keeps its own shape, so no one is cut off at the side. */
  .gf-inside__photo { margin: 0; overflow: hidden; border-radius: 26px; box-shadow: 0 22px 50px rgba(8, 43, 89, 0.16); }
  .gf-inside__photo img { display: block; width: 100%; height: auto; }
  .gf-checks { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .gf-checks li { display: flex; align-items: flex-start; gap: 0.65rem; color: var(--text-body); font-size: 1.125rem; line-height: 1.45; }
  .gf-checks__tick { flex: none; display: grid; place-items: center; width: 24px; height: 24px; margin-top: 0.1rem; border-radius: 50%; background: var(--blue); color: #fff; }
  .gf-checks__tick :global(svg) { width: 14px; height: 14px; stroke-width: 3; }
  .gf-dates { margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.2rem 0.5rem; font-size: 1rem; color: var(--text-body); }

  /* ---------- More free guides ---------- */
  .gf-library { padding-block: clamp(3rem, 6vw, 5rem); background: #F7F4EF; }
  .gf-library__sub { margin-top: 0.5rem; text-align: center; font-family: var(--font-serif); font-weight: 600; font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem); color: #0F5F9F; }
  .gf-library__lead { margin: 0.8rem auto 0; max-width: 44rem; text-align: center; color: var(--text-body); font-size: 1.125rem; line-height: 1.55; }
  .gf-library__grid { list-style: none; margin: clamp(1.75rem, 3vw, 2.5rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .gf-library__card { display: flex; }
  .gf-library__link {
    display: flex; flex-direction: column; width: 100%; overflow: hidden; border-radius: 18px; background: #fff; color: inherit; text-decoration: none;
    box-shadow: 0 10px 28px rgba(8, 43, 89, 0.08); transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .gf-library__link:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(8, 43, 89, 0.14); }
  .gf-library__link:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  .gf-library__cover { display: grid; place-items: center; padding: 1.5rem 1.25rem 1.9rem; background: radial-gradient(closest-side, rgba(46, 168, 247, 0.18), transparent), linear-gradient(180deg, #EAF3FC, #F6FAFE); }
  .gf-library__cover :global(.gbook) { width: min(80%, 240px); }
  .gf-library__link:hover .gf-library__cover :global(.gbook) { transform: perspective(1400px) rotateY(-12deg) rotateX(2deg); }
  .gf-library__body { display: flex; flex-direction: column; flex: 1; padding: 1.1rem 1.3rem 1.35rem; }
  .gf-library__series { font-size: 0.9375rem; color: var(--text-body); }
  .gf-library__title { margin-top: 0.15rem; font-family: var(--font-serif); font-weight: 600; font-size: 1.375rem; line-height: 1.2; color: var(--navy); }
  .gf-library__more { margin-top: auto; padding-top: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 1.0625rem; color: var(--blue); }
  .gf-library__more :global(svg), .gf-library__all :global(svg) { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .gf-library__link:hover .gf-library__more :global(svg), .gf-library__all a:hover :global(svg) { transform: translateX(3px); }
  .gf-library__all { margin: clamp(1.5rem, 3vw, 2.25rem) 0 0; text-align: center; }
  .gf-library__all a {
    display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-sans); font-weight: 700; font-size: 1rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: #0F5F9F; text-decoration: underline; text-underline-offset: 4px;
  }

  /* ---------- Final call to action ---------- */
  .gf-close {
    color: #fff; padding-block: clamp(3rem, 6vw, 4.75rem); text-align: center;
    background:
      linear-gradient(0deg, rgba(6, 32, 88, 0.9), rgba(6, 32, 88, 0.9)),
      url('/images/guides/coast-band.webp') center / cover no-repeat, var(--navy);
  }
  .gf-close__inner { display: grid; justify-items: center; }
  .gf-close .gf-close__title { margin-top: 0; color: #fff; }
  .gf-close__sub { margin-top: 0.6rem; font-family: var(--font-serif); font-weight: 600; font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem); line-height: 1.3; color: var(--blue-soft); }
  .gf-close__body { margin-top: 1rem; max-width: 38rem; color: rgba(255, 255, 255, 0.9); font-size: 1.125rem; line-height: 1.6; }
  .gf-close__btn {
    margin-top: 1.6rem; display: inline-flex; align-items: center; gap: 0.55rem; padding: 1.05rem 2.1rem; border-radius: 999px;
    font-family: var(--font-sans); font-weight: 700; font-size: 1.0625rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #fff; background: linear-gradient(180deg, #1E86D8, var(--blue)); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease;
  }
  .gf-close__btn :global(svg) { width: 20px; height: 20px; }
  .gf-close__btn:hover { transform: translateY(-2px); color: #fff; }
  .gf-close__btn:focus-visible { outline: 3px solid var(--blue-soft); outline-offset: 3px; }
  .gf-close__note { margin-top: 0.85rem; font-size: 1rem; color: rgba(255, 255, 255, 0.85); }

  /* ---------- Narrower screens ---------- */
  @media (max-width: 1100px) {
    .gf-library__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    /* Stacked: headline, then the cover, then the form. */
    /* Stacked: headline, cover, form, then the intro, so the button stays on a phone's first screen. */
    .gf-hero__inner { grid-template-columns: 1fr; grid-template-areas: 'head' 'book' 'form' 'intro'; row-gap: 0.9rem; }
    .gf-hero__head, .gf-hero__form, .gf-intro { max-width: none; }
    .gf-hero__form { margin-top: 0; }
    .gf-hero__book { justify-self: center; width: min(36%, 190px); margin: 0.25rem 0; }
    .gf-trust__inner { flex-direction: column; align-items: flex-start; }
    .gf-trust__list { grid-template-columns: 1fr; gap: 1.1rem; }
    .gf-inside__inner { grid-template-columns: 1fr; }
  }
  /* Short phones (iPhone SE and similar): a smaller cover and tighter headings keep the button on the first screen. */
  @media (max-width: 900px) and (max-height: 740px) {
    .gf-hero__inner { row-gap: 0.7rem; padding-block: 1rem 2rem; }
    .gf-hero__book { width: min(24%, 120px); margin: 0; }
    .gf-title { font-size: 1.875rem; }
    .gf-sub { font-size: 1.125rem; margin-top: 0.4rem; }
  }
  @media (max-width: 560px) {
    .gf-dates { flex-direction: column; }
    .gf-dates > [aria-hidden] { display: none; }
    /* Two cards a row, so the four covers fit in about one screen. */
    .gf-library__grid { gap: 0.75rem; }
    .gf-library__cover { padding: 1.1rem 0.75rem 1.4rem; }
    .gf-library__cover :global(.gbook) { width: 80%; }
    .gf-library__body { padding: 0.85rem 0.9rem 1rem; }
    .gf-library__series { font-size: 0.875rem; }
    .gf-library__title { font-size: 1.1875rem; }
    .gf-library__more { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gf-library__link, .gf-close__btn { transition: none; }
  }
</style>
