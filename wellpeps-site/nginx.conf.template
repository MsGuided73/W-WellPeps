# Serves Astro's static output. Routes are directory-style
# (/weight-loss/ -> /weight-loss/index.html), so try_files resolves those.
#
# This is an envsubst template. The nginx image renders it at container start
# to /etc/nginx/conf.d/default.conf (which is included inside the http block,
# so the map/limit_req_zone below are http-level). NGINX_ENVSUBST_FILTER in the
# Dockerfile limits substitution to SITE_GATE_* env vars, so nginx's own
# variables ($uri, $cookie_*, ...) pass through untouched.
#
# --- Private-preview gate ----------------------------------------------------
# SITE_GATE_HASH = lowercase hex SHA-256 of "wellpeps-gate:" + password
# (node scripts/gate-hash.mjs "pw"). Empty = gate off, site fully public.
# While on, every HTML route answers 401 with the branded gate page
# (/preview-access/index.html) until the visitor holds a wp_gate cookie equal
# to the hash. Static assets stay public so the gate page can render.

# 1 = let the request through. Key is "<hash>:<cookie>".
#   "^:"            hash empty -> gate off, pass everyone (even stale cookies)
#   "^<h>:<h>$"     cookie matches the configured hash
# Regex keys (not exact keys) on purpose: a 64-char exact key overflows the
# default map_hash_bucket_size (64) and nginx refuses to start.
map "${SITE_GATE_HASH}:$cookie_wp_gate" $gate_ok {
    default                                     0;
    "~^:"                                       1;
    "~^${SITE_GATE_HASH}:${SITE_GATE_HASH}$"    1;
}

# 1 = the unlock request carries the right hash. Never 1 while the gate is off.
map "${SITE_GATE_HASH}:$http_x_wp_gate" $gate_unlock_ok {
    default                                     0;
    "~^:"                                       0;
    "~^${SITE_GATE_HASH}:${SITE_GATE_HASH}$"    1;
}

# While the gate is on, unlocked HTML must not be stored by shared caches.
# An empty value makes add_header send nothing (gate off = unchanged headers).
map "gate:${SITE_GATE_HASH}" $gate_html_cache_control {
    "gate:"     "";
    default     "private, no-cache";
}

# Unlock attempts per client address. Behind Coolify's Traefik proxy
# $binary_remote_addr is usually the proxy's IP, so this can act as one shared
# bucket for everyone: keep it generous.
limit_req_zone $binary_remote_addr zone=gate_unlock:1m rate=30r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Redirects (e.g. /weight-loss -> /weight-loss/, /peptides) send a relative
    # Location. nginx sits behind TLS-terminating Traefik and only sees http,
    # so absolute redirects downgraded visitors from https to http.
    absolute_redirect off;

    # Locked HTML routes return 401 and render the gate page in place, so the
    # visitor stays on the URL they asked for.
    error_page 401 /preview-access/index.html;

    # Fingerprinted build assets never change — cache them hard.
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Other static media — cache moderately.
    location ~* \.(?:jpg|jpeg|png|webp|avif|gif|svg|ico|woff2?|ttf)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # Gate page: only reachable as the 401 error page (internal). Direct hits
    # on /preview-access/... are 404 so it never shows when the gate is off.
    location = /preview-access/index.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
    location ^~ /preview-access/ {
        return 404;
    }

    # Unlock: the gate page sends the hash in the X-WP-Gate header.
    # limit_req runs in the preaccess phase, which comes AFTER the rewrite
    # phase where `return` executes — so this location must not `return`
    # itself. try_files (a later phase) hands off to @gate_unlock instead.
    location = /__unlock {
        limit_req zone=gate_unlock burst=10 nodelay;
        limit_req_status 429;
        try_files /__gate_no_such_file__ @gate_unlock;
    }
    location @gate_unlock {
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        if ($gate_unlock_ok = 1) {
            # add_header inside `if` replaces the outer ones, so repeat them.
            add_header Cache-Control "no-store" always;
            add_header X-Robots-Tag "noindex, nofollow" always;
            add_header Set-Cookie "wp_gate=${SITE_GATE_HASH}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax" always;
            return 204;
        }
        return 403;
    }

    # Renamed 2026-09-19: the Healthy Aging & Vitality program moved from
    # /peptides to /healthy-aging. Astro also emits a meta-refresh stub at
    # /peptides/, but a real 301 here is what search engines need, and it
    # takes precedence because an exact-match location beats the prefix below.
    location = /peptides {
        if ($gate_ok = 0) { return 401; }
        return 301 /healthy-aging;
    }
    location = /peptides/ {
        if ($gate_ok = 0) { return 401; }
        return 301 /healthy-aging;
    }

    # HTML routes: exact file, directory index, or <name>.html; else 404.
    location / {
        if ($gate_ok = 0) { return 401; }

        try_files $uri $uri/ $uri.html =404;

        # Security headers on document responses.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control $gate_html_cache_control;
    }

    # Don't serve dotfiles.
    location ~ /\. { deny all; }
}
