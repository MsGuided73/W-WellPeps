{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wellpeps-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "wellpeps-site",
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "wellpeps-guides",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "dev",
        "--port",
        "4325"
      ],
      "cwd": "wellpeps-site",
      "port": 4325,
      "env": {
        "PUBLIC_GUIDE_FLOW": "landing"
      }
    }
  ]
}